# Copy to .env for local dev. In production use Fly secrets.
# Never commit real values.

# Required
DASHBOARD_JWT_SECRET=change-me-32-chars-minimum

# Zernio API key (same key used in fly-service, or a per-client key via apiKeyEnv in users.json)
ZERNIO_API_KEY=

# Email — at least one backend required for production magic-link emails.
# Dev: if neither is set, magic links are printed to stdout.

# Option A: EmailIt (https://emailit.com)
EMAILIT_API_KEY=

# Option B: Mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

EMAIL_FROM=Attention Earned <dashboard@attentionearned.com>

# Public URL of this dashboard (for magic-link emails and OAuth callbacks)
DASHBOARD_URL=https://dashboard.attentionearned.com

# Users config — defaults to ../fly-service/users.json (monorepo layout)
# Override when deploying separately:
# USERS_FILE=/app/users.json

# Optional: comma-separated admin emails (also accepts david@attentionearned.com by default)
# ADMIN_EMAILS=chaitd@outlook.com,david@attentionearned.com

# Port (defaults to 4000)
# PORT=4000
