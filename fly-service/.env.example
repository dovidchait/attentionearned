# Copy to .env for local dev. In production set these with `fly secrets set` (see README).
# Never commit a real value.

# Zernio (posting). Key from zernio.com > Settings > API keys
ZERNIO_API_KEY=
# Optional: secret from the Zernio webhook you create for /zernio-webhook
# (needed for "it's live" links on scheduled/queued posts)
ZERNIO_WEBHOOK_SECRET=

# Twilio (SMS + WhatsApp intake/replies, calendar SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1YOURTWILIONUMBER
# Optional: WhatsApp sender if it differs from the number people message
# TWILIO_WHATSAPP_FROM=+1YOURTWILIONUMBER

# Optional extra allowlists (comma separated). users.json is already the allowlist.
ALLOWED_NUMBERS=
ALLOWED_WHATSAPP_NUMBERS=
ALLOWED_SENDERS=

# Email intake/replies
EMAILIT_API_KEY=
# EMAIL_FROM=Text to Attention <post@attentionearned.com>
# EMAIL_WEBHOOK_SECRET=   (then add ?secret=... to the inbound email webhook URL)

# Calendar reminders
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
CALENDAR_ID=david@attentionearned.com
REMINDER_TO_NUMBER=+1YOURFLIPPHONE
# REMINDER_FROM_NUMBER defaults to TWILIO_FROM_NUMBER if not set
