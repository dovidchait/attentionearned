# Copy to .env for local dev. In production set these with `fly secrets set` (see README).
# Never commit a real value.

# Zernio (posting). Key from zernio.com > Settings > API keys
ZERNIO_API_KEY=
# Optional: secret from the Zernio webhook you create for /zernio-webhook
# (needed for "it's live" links on scheduled/queued posts)
ZERNIO_WEBHOOK_SECRET=

# Twilio (WhatsApp + SMS intake/replies, calendar SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional: the public URL Twilio calls, if signature checks fail behind a proxy
# PUBLIC_BASE_URL=https://text-to-attention.fly.dev
# Local tests only. Never in production:
# TWILIO_SKIP_SIGNATURE_CHECK=true

# WhatsApp (Twilio WhatsApp sender). Number only, no "whatsapp:" prefix.
# Sandbox while the sender is pending: +14155238886
TWILIO_WHATSAPP_FROM=+1YOURWHATSAPPSENDER
# Approved "post is live" template (Content SID, starts with HX). Used when a
# post goes live more than 24 h after the person's last WhatsApp message.
TWILIO_WA_TEMPLATE_POSTED_SID=

# SMS stays off until the toll-free number is verified
SMS_ENABLED=false
TWILIO_FROM_NUMBER=+1YOURTWILIONUMBER

# users.json is the allowlist: only people listed there can post.
# Optional EXTRA allowlists (comma separated). They are ignored unless
# ENFORCE_ENV_ALLOWLIST=true, so leftover values can't block someone in users.json.
# ENFORCE_ENV_ALLOWLIST=false
ALLOWED_NUMBERS=
ALLOWED_WHATSAPP_NUMBERS=
ALLOWED_SENDERS=

# Email in/out (Emailit, see README "Email")
# API key with Full Access (reading received mail needs it)
EMAILIT_API_KEY=
# Secret of the Emailit webhook (email.received) pointing at /email-webhook, whole value incl. whsec_
EMAILIT_WEBHOOK_SECRET=
# From must be on a domain verified in Emailit. Optional: defaults to
# Attention Earned <post@attentionearned.com>. Type it WITHOUT surrounding quotes
# (stray quotes/spaces are stripped anyway; an invalid value falls back to the default).
EMAIL_FROM=Attention Earned <post@attentionearned.com>
# Where client replies go: the Emailit inbound address (no quotes)
EMAIL_REPLY_TO=post@inbound.attentionearned.com
# Refuse inbound mail whose SPF/DKIM/DMARC results failed (forged From). Default true.
# EMAIL_REQUIRE_AUTH=true
# Only for a non-Emailit forwarder posting to /email-webhook?secret=...
# EMAIL_WEBHOOK_SECRET=
# EMAILIT_API_URL=https://api.emailit.com/v2

# Media links (Dropbox / Google Drive) download limit, MB
# MAX_LINK_MEDIA_MB=250

# Where opt-outs and last-message times are saved (a Fly volume at /data is used automatically)
# STATE_DIR=/data

# Subtitles (burned-in captions, Whisper transcription)
# Needed for "with subtitles" posts and the brand onboarding helper
OPENAI_API_KEY=

# Calendar reminders
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
CALENDAR_ID=david@attentionearned.com
REMINDER_TO_NUMBER=+1YOURFLIPPHONE
# REMINDER_FROM_NUMBER defaults to TWILIO_FROM_NUMBER if not set
