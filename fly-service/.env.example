# Late.dev
LATE_API_KEY=

# Twilio (shared for posting webhooks + calendar SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1YOURNUMBER

# Social posting access control
ALLOWED_NUMBERS=+1YOURNUMBER
ALLOWED_WHATSAPP_NUMBERS=+1YOURNUMBER
ALLOWED_SENDERS=david@attentionearned.com

# Calendar reminders
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
CALENDAR_ID=david@attentionearned.com
REMINDER_TO_NUMBER=+1YOURFLIPPHONE
# REMINDER_FROM_NUMBER defaults to TWILIO_FROM_NUMBER if not set

# Optional: email confirmations
EMAILIT_API_KEY=
