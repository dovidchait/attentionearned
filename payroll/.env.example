# Copy this file to .env and fill in real values. Never commit .env.

# --- Jibble (https://jibble.io) ---
# Organization Settings > API Keys in your Jibble account (requires a plan
# with API access). Used for the OAuth client-credentials flow.
JIBBLE_CLIENT_ID=
JIBBLE_CLIENT_SECRET=
# The employee's Jibble Person ID (not their email). Run:
#   python pay_employee.py --jibble-raw --start 2026-01-01 --end 2026-01-01
# once against a known day, or check the Jibble People admin page/export, to
# find it.
JIBBLE_PERSON_ID=

# --- Wise (https://wise.com) ---
# Personal API token: Wise account > Connect and manage apps > API tokens.
# Personal tokens can create quotes/recipients/transfers but cannot fund a
# transfer -- that step always needs a manual login (by design, per Wise's
# SCA/2FA requirements).
WISE_API_TOKEN=
# production or sandbox
WISE_ENV=production
# Optional: override the API base URL entirely (useful if Wise's sandbox
# base URL changes during their v1->v2 sandbox migration). Leave blank to
# use the default for WISE_ENV.
WISE_API_BASE=
# Your Wise profile ID (personal or business) that's sending the money.
WISE_PROFILE_ID=
# The employee's saved recipient (bank account) ID in your Wise account.
WISE_RECIPIENT_ID=

# --- Pay calculation ---
HOURLY_RATE=
# Currency the hourly rate is denominated in (e.g. USD). If this differs
# from PAYOUT_CURRENCY, Wise's live quote converts it automatically.
RATE_CURRENCY=USD
# Currency the employee is actually paid in.
PAYOUT_CURRENCY=PHP

# --- Ledger ---
# Path to the running-balance CSV. Relative paths are resolved from wherever
# you run the script.
LEDGER_PATH=ledger.csv
