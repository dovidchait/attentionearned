---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner container">
    <div class="site-footer__brand">
      <a href="/" aria-label="Attention Earned home">
        <img src="/wordmark-light.svg" alt="Attention Earned" height="18" width="148" />
      </a>
      <p class="site-footer__tagline">Video that earns attention.</p>
    </div>

    <div class="site-footer__right">
      <nav aria-label="Footer navigation" class="site-footer__nav">
        <a href="/work">Work</a>
        <a href="/services">Services</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
      </nav>

      <div class="site-footer__social" aria-label="Social links">
        <a href="https://www.youtube.com/@attentionearned" class="site-footer__social-link" aria-label="YouTube" rel="noopener noreferrer" target="_blank">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.8 8s-.2-1.4-.8-2c-.8-.8-1.7-.8-2.1-.9C16.6 5 12 5 12 5s-4.6 0-6.9.1c-.4.1-1.3.1-2.1.9-.6.6-.8 2-.8 2S2 9.6 2 11.2v1.5c0 1.6.2 3.2.2 3.2s.2 1.4.8 2c.8.8 1.8.8 2.3.8C6.8 19 12 19 12 19s4.6 0 6.9-.2c.4-.1 1.3-.1 2.1-.9.6-.6.8-2 .8-2s.2-1.6.2-3.2v-1.5C22 9.6 21.8 8 21.8 8zM9.7 14.5V9l5.7 2.8-5.7 2.7z"/></svg>
        </a>
        <a href="https://www.instagram.com/attentionearned" class="site-footer__social-link" aria-label="Instagram" rel="noopener noreferrer" target="_blank">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        </a>
        <a href="https://www.linkedin.com/company/attentionearned" class="site-footer__social-link" aria-label="LinkedIn" rel="noopener noreferrer" target="_blank">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
      </div>
    </div>
  </div>

  <div class="site-footer__bottom container">
    <p class="site-footer__copy">&copy; {year} Attention Earned. All rights reserved.</p>
    <a href="/privacy" class="site-footer__privacy">Privacy</a>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink-950);
    border-top: 1px solid var(--border-subtle);
    padding-top: 3rem;
  }

  .site-footer__inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    padding-bottom: 2.5rem;
  }

  .site-footer__brand {}

  .site-footer__brand img {
    height: 18px;
    width: auto;
    opacity: 0.7;
    transition: opacity var(--dur-fast);
  }

  .site-footer__brand img:hover { opacity: 1; }

  .site-footer__tagline {
    margin-top: 0.5rem;
    font-size: var(--fs-xs);
    color: var(--text-faint);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .site-footer__right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1.25rem;
  }

  .site-footer__nav {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .site-footer__nav a {
    font-size: var(--fs-sm);
    color: var(--text-faint);
    transition: color var(--dur-fast);
  }

  .site-footer__nav a:hover { color: var(--text-muted); }

  .site-footer__social {
    display: flex;
    gap: 0.875rem;
    align-items: center;
  }

  .site-footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: var(--text-faint);
    border: 1px solid var(--border-subtle);
    transition: color var(--dur-fast), border-color var(--dur-fast), background var(--dur-fast);
  }

  .site-footer__social-link:hover {
    color: var(--accent-soft);
    border-color: rgba(252, 44, 48, 0.35);
    background: var(--accent-quiet);
  }

  .site-footer__bottom {
    border-top: 1px solid var(--border-subtle);
    padding-top: 1.25rem;
    padding-bottom: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .site-footer__copy {
    font-size: var(--fs-xs);
    color: var(--stone-400);
    font-family: var(--font-mono);
  }

  .site-footer__privacy {
    font-size: var(--fs-xs);
    color: var(--text-faint);
    font-family: var(--font-mono);
    transition: color var(--dur-fast);
  }

  .site-footer__privacy:hover { color: var(--text-muted); }

  @media (max-width: 600px) {
    .site-footer__right { align-items: flex-start; }
  }
</style>
