---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner container">
    <div class="site-footer__brand">
      <a href="/" aria-label="Attention Earned home">
        <img src="/wordmark-white.svg" alt="Attention Earned" height="18" width="148" />
      </a>
      <p class="site-footer__tagline">Video that earns attention.</p>
    </div>

    <nav aria-label="Footer navigation" class="site-footer__nav">
      <a href="/work">Work</a>
      <a href="/services">Services</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
    </nav>
  </div>

  <div class="site-footer__bottom container">
    <p class="site-footer__copy">&copy; {year} Attention Earned. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink-950);
    border-top: 1px solid var(--border-subtle);
    padding-top: 3rem;
  }

  .site-footer__inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    padding-bottom: 2.5rem;
  }

  .site-footer__brand {}

  .site-footer__brand img {
    height: 18px;
    width: auto;
    opacity: 0.7;
    transition: opacity var(--dur-fast);
  }

  .site-footer__brand img:hover { opacity: 1; }

  .site-footer__tagline {
    margin-top: 0.5rem;
    font-size: var(--fs-xs);
    color: var(--text-faint);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .site-footer__nav {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .site-footer__nav a {
    font-size: var(--fs-sm);
    color: var(--text-faint);
    transition: color var(--dur-fast);
  }

  .site-footer__nav a:hover { color: var(--text-muted); }

  .site-footer__bottom {
    border-top: 1px solid var(--border-subtle);
    padding-top: 1.25rem;
    padding-bottom: 1.5rem;
  }

  .site-footer__copy {
    font-size: var(--fs-xs);
    color: var(--stone-400);
    font-family: var(--font-mono);
  }
</style>
