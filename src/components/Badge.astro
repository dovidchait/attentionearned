---
interface Props {
  tone?: 'accent' | 'neutral' | 'outline' | 'success' | 'warning';
  dot?: boolean;
  class?: string;
}

const { tone = 'neutral', dot = false, class: className } = Astro.props;
---

<span class:list={['ae-badge', `ae-badge--${tone}`, className]}>
  {dot && <span class="ae-badge__dot" aria-hidden="true" />}
  <slot />
</span>

<style>
  .ae-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    line-height: 1;
  }

  .ae-badge--neutral {
    background: var(--surface-card);
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
  }

  .ae-badge--accent {
    background: var(--accent-quiet);
    color: var(--accent-soft);
    border: 1px solid rgba(252, 44, 48, 0.25);
  }

  .ae-badge--outline {
    background: transparent;
    color: var(--text-muted);
    border: 1px solid var(--border-mid);
  }

  .ae-badge--success {
    background: rgba(79, 191, 139, 0.12);
    color: var(--ok);
    border: 1px solid rgba(79, 191, 139, 0.25);
  }

  .ae-badge--warning {
    background: rgba(233, 185, 73, 0.12);
    color: var(--warn);
    border: 1px solid rgba(233, 185, 73, 0.25);
  }

  .ae-badge__dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    flex-shrink: 0;
  }
</style>
