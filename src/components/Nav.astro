---
const links = [
  { href: '/work', label: 'Work' },
  { href: '/services', label: 'Services' },
  { href: '/about', label: 'About' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="site-nav">
  <div class="site-nav__inner">
    <a href="/" class="site-nav__logo" aria-label="Attention Earned home">
      <img src="/wordmark-light.svg" alt="Attention Earned" height="22" width="180" />
    </a>

    <nav aria-label="Main navigation" class="site-nav__links">
      {links.map(({ href, label }) => (
        <a
          href={href}
          class:list={['site-nav__link', { 'site-nav__link--active': isActive(href) }]}
          aria-current={isActive(href) ? 'page' : undefined}
        >
          {label}
        </a>
      ))}
    </nav>

    <a href="/contact" class="site-nav__cta">Contact</a>

    <button class="site-nav__toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="nav-mobile">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </div>

  <div class="site-nav__mobile" id="nav-mobile" aria-hidden="true">
    {links.map(({ href, label }) => (
      <a href={href} class="site-nav__mobile-link">{label}</a>
    ))}
    <a href="/contact" class="site-nav__mobile-link site-nav__mobile-link--cta">Contact</a>
  </div>
</header>

<script>
  const toggle = document.querySelector('.site-nav__toggle') as HTMLButtonElement;
  const mobile = document.querySelector('.site-nav__mobile') as HTMLElement;

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Open navigation' : 'Close navigation');
    mobile.dataset.open = open ? '' : 'true';
    mobile.setAttribute('aria-hidden', open ? 'true' : 'false');
  });
</script>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(14, 14, 12, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .site-nav__inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter);
    height: 60px;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .site-nav__logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .site-nav__logo img {
    height: 22px;
    width: auto;
    display: block;
  }

  .site-nav__links {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-left: auto;
  }

  .site-nav__link {
    position: relative;
    font-size: var(--fs-sm);
    color: var(--text-muted);
    transition: color var(--dur-fast) var(--ease-out);
    padding-bottom: 2px;
  }

  .site-nav__link:hover { color: var(--text-strong); }

  .site-nav__link--active {
    color: var(--text-strong);
  }

  .site-nav__link--active::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
  }

  .site-nav__cta {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 1.1rem;
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    color: var(--text-strong);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    transition: border-color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .site-nav__cta:hover {
    border-color: var(--accent);
    background: var(--accent-quiet);
    color: var(--accent-soft);
  }

  .site-nav__toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    margin-left: auto;
  }

  .bar {
    display: block;
    width: 22px;
    height: 1.5px;
    background: var(--text-muted);
    border-radius: 1px;
    transform-origin: center;
    transition: transform var(--dur-base) var(--ease-out), opacity var(--dur-fast), background var(--dur-fast);
  }

  .site-nav__toggle[aria-expanded="true"] .bar:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
    background: var(--text-strong);
  }
  .site-nav__toggle[aria-expanded="true"] .bar:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .site-nav__toggle[aria-expanded="true"] .bar:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
    background: var(--text-strong);
  }

  .site-nav__mobile {
    display: none;
    flex-direction: column;
    padding: 1rem var(--gutter) 1.5rem;
    border-top: 1px solid var(--border-subtle);
    background: var(--ink-900);
  }

  .site-nav__mobile[data-open="true"] { display: flex; }

  .site-nav__mobile-link {
    padding: 0.75rem 0;
    font-size: var(--fs-body);
    color: var(--text-muted);
    border-bottom: 1px solid var(--border-subtle);
    transition: color var(--dur-fast);
  }

  .site-nav__mobile-link:hover { color: var(--text-strong); }

  .site-nav__mobile-link--cta {
    margin-top: 1rem;
    color: var(--accent-soft);
    border-bottom: none;
    font-weight: var(--fw-bold);
  }

  @media (max-width: 640px) {
    .site-nav__links { display: none; }
    .site-nav__cta { display: none; }
    .site-nav__toggle { display: flex; }
    .site-nav__mobile { display: none; }
    .site-nav__mobile[data-open="true"] { display: flex; }
  }
</style>
