---
interface Props {
  provider: 'swarmify' | 'youtube' | 'vimeo';
  src: string;
  poster?: string;
  title?: string;
}

const { provider, src, poster, title = 'Video' } = Astro.props;

const youtubeEmbedUrl = `https://www.youtube-nocookie.com/embed/${src}?rel=0&modestbranding=1`;
const vimeoEmbedUrl   = `https://player.vimeo.com/video/${src}?dnt=1`;
---

<div class="video-wrapper">
  {provider === 'swarmify' && (
    <smartvideo src={src} poster={poster} fluid></smartvideo>
  )}

  {provider === 'youtube' && (
    <iframe
      src={youtubeEmbedUrl}
      title={title}
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
      loading="lazy"
    ></iframe>
  )}

  {provider === 'vimeo' && (
    <iframe
      src={vimeoEmbedUrl}
      title={title}
      allow="autoplay; fullscreen; picture-in-picture"
      allowfullscreen
      loading="lazy"
    ></iframe>
  )}
</div>

<style>
  .video-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--color-dark);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .video-wrapper iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .video-wrapper smartvideo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>
