---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { title, client, sector, video } = entry.data;
const url = `/work/${entry.id}`;

const isYoutube = video?.provider === 'youtube';
const thumb = isYoutube ? `https://img.youtube.com/vi/${video!.src}/hqdefault.jpg` : video?.poster;

const sectorLabels: Record<string, string> = {
  corporate:           'Corporate',
  healthcare:          'Healthcare',
  nonprofit:           'Nonprofit',
  film:                'Film',
  'music-video':       'Music Video',
  commercial:          'Commercial',
  fashion:             'Fashion',
  'behind-the-scenes': 'Behind the Scenes',
};
---

<a href={url} class="work-card">
  <div class="work-card__thumb">
    {thumb
      ? <img src={thumb} alt="" loading="lazy" class="work-card__img" />
      : <div class="work-card__placeholder" />
    }
    <div class="work-card__overlay" />
    <div class="work-card__info">
      <span class="work-card__sector">{sectorLabels[sector] ?? sector}</span>
      <span class="work-card__title">{title}</span>
      {client && <span class="work-card__client">{client}</span>}
    </div>
  </div>
</a>

<style>
  .work-card {
    display: block;
    text-decoration: none;
    border-radius: var(--radius-card);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    transition: transform var(--dur-base) var(--ease-out), border-color var(--dur-base) ease, box-shadow var(--dur-base) ease;
  }

  .work-card:hover {
    transform: translateY(-4px);
    border-color: rgba(252, 44, 48, 0.42);
    box-shadow: 0 10px 40px -8px rgba(252, 44, 48, 0.28);
  }

  .work-card__thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    background: radial-gradient(120% 120% at 30% 20%, hsl(16 50% 18%) 0%, hsl(16 40% 10%) 45%, var(--surface-inset) 100%);
    overflow: hidden;
  }

  .work-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.75;
    display: block;
    transition: opacity var(--dur-base) ease;
  }

  .work-card:hover .work-card__img { opacity: 0.9; }

  .work-card__placeholder {
    position: absolute;
    inset: 0;
  }

  .work-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(11,10,9,.85) 0%, transparent 50%);
  }

  .work-card__info {
    position: absolute;
    left: 14px;
    bottom: 12px;
    right: 14px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .work-card__sector {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--accent-soft);
  }

  .work-card__title {
    color: var(--paper);
    font-weight: var(--fw-bold);
    font-size: 15px;
    line-height: var(--lh-snug);
    margin-top: 2px;
  }

  .work-card__client {
    color: var(--stone-300);
    font-size: 12px;
    font-style: italic;
  }
</style>
