---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
  variant?: 'default' | 'featured';
}

const { entry, variant = 'default' } = Astro.props;
const { title, client, sector, summary, video } = entry.data;
const url = `/work/${entry.id}`;

const sectorLabels: Record<string, string> = {
  corporate:            'Corporate',
  healthcare:           'Healthcare',
  nonprofit:            'Nonprofit',
  film:                 'Film',
  'music-video':        'Music Video',
  commercial:           'Commercial',
  fashion:              'Fashion',
  'behind-the-scenes':  'Behind the Scenes',
};
---

<article class:list={['work-card', `work-card--${variant}`]}>
  {video?.poster ? (
    <a href={url} class="work-card__thumb" tabindex="-1" aria-hidden="true">
      <img src={video.poster} alt="" loading="lazy" />
      <span class="work-card__play" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
      </span>
    </a>
  ) : (
    <a href={url} class="work-card__thumb work-card__thumb--empty" tabindex="-1" aria-hidden="true">
      <span class="work-card__thumb-placeholder"></span>
    </a>
  )}

  <div class="work-card__body">
    <span class="work-card__sector">{sectorLabels[sector] ?? sector}</span>
    <h3 class="work-card__title">
      <a href={url}>{title}</a>
    </h3>
    {client && <p class="work-card__client">{client}</p>}
    <p class="work-card__summary">{summary}</p>
    <a href={url} class="work-card__cta">View project →</a>
  </div>
</article>

<style>
  .work-card {
    display: flex;
    flex-direction: column;
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition:
      box-shadow var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }

  .work-card:hover {
    box-shadow: var(--shadow-pop);
    transform: translateY(-3px);
    border-color: rgba(252, 44, 48, 0.3);
  }

  .work-card__thumb {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface-inset);
  }

  .work-card__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .work-card:hover .work-card__thumb img { transform: scale(1.04); }

  .work-card__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
  }

  .work-card__play svg {
    width: 48px;
    height: 48px;
    padding: 14px;
    border-radius: 50%;
    background: rgba(252, 44, 48, 0.9);
    box-shadow: 0 4px 20px rgba(252, 44, 48, 0.5);
    color: #fff;
  }

  .work-card:hover .work-card__play { opacity: 1; }

  .work-card__thumb--empty {}
  .work-card__thumb-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    background: radial-gradient(120% 120% at 30% 20%, hsl(16 50% 14%) 0%, var(--surface-inset) 100%);
  }

  .work-card__body {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .work-card__sector {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--accent-soft);
  }

  .work-card__title {
    font-size: var(--fs-h3);
    letter-spacing: var(--tracking-tight);
    margin-top: var(--space-1);
  }

  .work-card__title a { color: var(--text-strong); }
  .work-card__title a:hover { color: var(--accent-soft); }

  .work-card__client {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    font-style: italic;
  }

  .work-card__summary {
    font-size: var(--fs-body);
    color: var(--text-muted);
    line-height: var(--lh-body);
    margin-top: var(--space-2);
    flex: 1;
  }

  .work-card__cta {
    display: inline-block;
    margin-top: var(--space-4);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    color: var(--accent-soft);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .work-card__cta:hover { color: var(--accent); }

  .work-card--featured {
    border-top: 2px solid var(--accent);
  }
</style>
