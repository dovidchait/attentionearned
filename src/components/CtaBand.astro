---
interface Props {
  heading: string;
  accentPhrase?: string;
  body?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  heading,
  accentPhrase,
  body,
  primaryLabel = 'Start your project',
  primaryHref = '/contact',
  secondaryLabel,
  secondaryHref = '/work',
} = Astro.props;
---

<section class="cta-band">
  <div class="cta-band__inner">
    <h2 class="cta-band__heading">
      {heading}{accentPhrase && <> <span class="cta-band__accent">{accentPhrase}</span></>}
    </h2>
    {body && <p class="cta-band__body">{body}</p>}
    <div class="cta-band__actions">
      <a href={primaryHref} class="ae-btn ae-btn--primary ae-btn--lg">{primaryLabel}</a>
      {secondaryLabel && (
        <a href={secondaryHref} class="ae-btn ae-btn--ghost ae-btn--lg">{secondaryLabel}</a>
      )}
    </div>
  </div>
</section>

<style>
  .cta-band {
    background-image: var(--grad-hero);
    text-align: center;
    padding: clamp(4rem, 8vw, 6rem) var(--gutter);
  }

  .cta-band__inner {
    max-width: 640px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .cta-band__heading {
    font-size: var(--fs-display-lg);
    letter-spacing: var(--tracking-display);
    color: var(--text-strong);
    text-wrap: balance;
  }

  .cta-band__accent { color: var(--ae-coral); }

  .cta-band__body {
    max-width: 52ch;
    color: var(--text-muted);
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body);
  }

  .cta-band__actions {
    display: flex;
    gap: 0.875rem;
    flex-wrap: wrap;
    justify-content: center;
  }

</style>
