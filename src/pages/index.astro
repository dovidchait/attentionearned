---
import Base from '../layouts/Base.astro';
import Kicker from '../components/Kicker.astro';
import CtaBand from '../components/CtaBand.astro';
import { AE_WORK } from '../data/work';

const featuredWork = AE_WORK
  .filter(w => w.featured != null)
  .sort((a, b) => (a.featured ?? 99) - (b.featured ?? 99));
---

<Base title="Attention Earned — Video That Makes People Buy">
  <!-- HERO -->
  <section class="hero">
    <div class="hero__inner ae-reveal">
      <Kicker>Video Production</Kicker>
      <h1 class="hero__h1">We don't make video.<br />We make people buy.</h1>
      <p class="hero__sub">
        For B2B teams and service brands who want to turn watchers into buyers.
        For founders who want to build trust, not just awareness. For nonprofits
        and missions that deserve more than applause — they deserve action.
      </p>
      <div class="hero__actions">
        <a href="/contact" class="btn-primary btn-lg">Let's make them feel something</a>
        <a href="/work" class="btn-ghost btn-lg">See our work</a>
      </div>
    </div>
  </section>

  <!-- SELECTED WORK -->
  <section class="work-section container">
    <h2 class="section-heading">Selected Work</h2>
    <div class="work-grid">
      {featuredWork.map((entry, i) => {
        const isVideo = entry.kind === 'dropbox-direct';
        const isYoutube = entry.kind === 'youtube';
        const thumb = isYoutube ? `https://img.youtube.com/vi/${entry.video}/hqdefault.jpg` : null;
        return (
          <a
            href={`/work/${entry.slug}`}
            class:list={['work-tile', { 'work-tile--wide': i === 0 }]}
          >
            {isVideo && (
              <video
                src={entry.video}
                muted
                loop
                autoplay
                playsinline
                preload="metadata"
                class="work-tile__media"
              />
            )}
            {thumb && <img src={thumb} alt="" class="work-tile__media" loading="lazy" />}
            <div class="work-tile__overlay" />
            <div class="work-tile__info">
              <span class="work-tile__sector">{entry.sector}</span>
              <span class="work-tile__title">{entry.title}</span>
              {entry.client && <span class="work-tile__client">{entry.client}</span>}
            </div>
          </a>
        );
      })}
    </div>
    <div class="work-link-row">
      <a href="/work" class="btn-secondary btn-md">View all work</a>
    </div>
  </section>

  <!-- SERVICES TEASER -->
  <section class="services-teaser">
    <div class="container">
      <h2 class="section-heading">What we do</h2>
      <p class="services-teaser__sub">
        From concept to delivery, we handle everything. Or we step in wherever you need us most.
      </p>
      <a href="/services" class="btn-primary btn-md">Explore services</a>
    </div>
  </section>

  <!-- BOTTOM CTA -->
  <CtaBand
    heading="We've been there, done that."
    accentPhrase=""
    body="Whatever your industry or story, we've probably solved something like it before — and we'll build something unique for what you need, not a template of what we've already made."
    primaryLabel="Start your project"
    primaryHref="/contact"
    secondaryLabel="See all work"
    secondaryHref="/work"
  />
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: min(84vh, 720px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(5rem, 12vw, 9rem) var(--gutter) clamp(4rem, 8vw, 7rem);
    text-align: center;
    overflow: hidden;
    background-image: var(--grad-hero);
  }

  .hero__inner {
    max-width: 840px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .hero__h1 {
    font-size: var(--fs-display-2xl);
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-display);
    color: var(--text-strong);
    text-wrap: balance;
  }

  .hero__sub {
    max-width: 56ch;
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: var(--lh-body);
    color: var(--text-muted);
  }

  .hero__actions {
    display: flex;
    gap: 0.875rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.5rem;
  }

  /* Shared buttons (local scope — Base has global CtaBand, these pages need standalone too) */
  .btn-primary,
  .btn-secondary,
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-sans);
    font-weight: var(--fw-bold);
    border-radius: var(--radius-pill);
    border: none;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
    transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out), background var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out);
  }

  .btn-lg { font-size: var(--fs-body); padding: 0.85rem 1.8rem; letter-spacing: 0.04em; }
  .btn-md { font-size: var(--fs-sm); padding: 0.65rem 1.3rem; letter-spacing: var(--tracking-wide); text-transform: uppercase; }

  .btn-primary {
    background: var(--grad-cta);
    color: var(--text-on-accent);
    box-shadow: var(--glow-cta);
  }
  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 14px 50px -8px rgba(252,44,48,0.7), 0 0 0 1px rgba(252,44,48,0.4);
  }

  .btn-secondary {
    background: transparent;
    color: var(--text-strong);
    border: 1px solid var(--border-strong);
  }
  .btn-secondary:hover { border-color: var(--accent); color: var(--accent-soft); transform: translateY(-1px); }

  .btn-ghost {
    background: transparent;
    color: var(--text-body);
    border: 1px solid var(--border-subtle);
  }
  .btn-ghost:hover { background: var(--surface-hover); color: var(--text-strong); }

  /* Work section */
  .work-section { padding-block: clamp(4rem, 8vw, 7rem); }

  .section-heading {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    margin-bottom: 1.75rem;
    color: var(--text-strong);
    letter-spacing: var(--tracking-display);
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  @media (max-width: 900px) {
    .work-grid { grid-template-columns: repeat(2, 1fr); }
    .work-tile--wide { grid-column: span 2; }
  }

  @media (max-width: 600px) {
    .work-grid { grid-template-columns: 1fr; }
    .work-tile--wide { grid-column: span 1; }
  }

  .work-tile--wide { grid-column: span 2; }

  .work-tile {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-card);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    background: radial-gradient(120% 120% at 30% 20%, hsl(16 50% 18%) 0%, hsl(16 40% 10%) 45%, #0B0A09 100%);
    text-decoration: none;
    transition: transform var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }

  .work-tile:hover {
    transform: translateY(-4px);
    border-color: rgba(252, 44, 48, 0.45);
    box-shadow: 0 24px 60px -24px rgba(0,0,0,.8), 0 0 46px -16px rgba(252,44,48,.3);
  }

  .work-tile__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
  }

  .work-tile__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(11,10,9,.85) 0%, transparent 45%);
  }

  .work-tile__info {
    position: absolute;
    left: 16px;
    bottom: 14px;
    right: 16px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .work-tile__sector {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--accent-soft);
  }

  .work-tile__title {
    color: var(--paper);
    font-weight: var(--fw-bold);
    font-size: 17px;
    line-height: var(--lh-snug);
  }

  .work-tile__client {
    color: var(--stone-300);
    font-size: 13px;
    font-style: italic;
  }

  .work-link-row {
    display: flex;
    justify-content: center;
    margin-top: 2.25rem;
  }

  /* Services teaser */
  .services-teaser {
    background: var(--surface-card);
    padding-block: clamp(4rem, 8vw, 7rem);
    text-align: center;
  }

  .services-teaser__sub {
    max-width: 52ch;
    margin: 0 auto 1.75rem;
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: var(--lh-body);
  }
</style>
