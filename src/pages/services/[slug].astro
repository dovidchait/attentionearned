---
import Base from '../../layouts/Base.astro';
import Kicker from '../../components/Kicker.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const entries = await getCollection('services');
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, num: i + 1 },
  }));
};

const { entry, num } = Astro.props;
const { Content } = await render(entry);
const { title, summary } = entry.data;
const numStr = String(num).padStart(2, '0');
---

<Base title={title} description={summary}>
  <article class="service-article container">
    <Kicker>Service · {numStr}</Kicker>
    <h1>{title}</h1>
    <p class="service-article__lede">{summary}</p>

    <div class="service-article__body prose">
      <Content />
    </div>

    <div class="service-article__cta">
      <a href="/contact" class="btn-primary btn-lg">Start your project</a>
    </div>
  </article>

  <CtaBand
    heading="Ready to talk through your project?"
    primaryLabel="Start the conversation"
    primaryHref="/contact"
  />
</Base>

<style>
  .service-article {
    max-width: var(--container-text);
    padding-block: clamp(4rem, 8vw, 6rem) 4rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .service-article h1 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    color: var(--text-strong);
    margin-top: 1rem;
  }

  .service-article__lede {
    font-size: 1.2rem;
    line-height: 1.65;
    color: var(--text-body);
    font-style: italic;
    max-width: 60ch;
  }

  .service-article__body {
    margin-top: 0.5rem;
  }

  .prose :global(h2), .prose :global(h3) {
    color: var(--text-strong);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .prose :global(h2) { font-size: 1.1rem; }
  .prose :global(h3) { font-size: 1rem; }

  .prose :global(p) {
    color: var(--text-body);
    line-height: 1.7;
    margin-bottom: 1rem;
    font-size: 1.05rem;
  }

  .prose :global(ul) {
    padding-left: 1.25rem;
    color: var(--text-body);
    line-height: 1.9;
    margin-bottom: 1rem;
  }

  .prose :global(li) { margin-bottom: 0.25rem; }

  .prose :global(strong) {
    font-weight: var(--fw-bold);
    color: var(--text-strong);
  }

  .service-article__cta {
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
    text-align: center;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-sans);
    font-weight: var(--fw-bold);
    border-radius: var(--radius-pill);
    border: none;
    cursor: pointer;
    text-decoration: none;
    background: var(--grad-cta);
    color: var(--text-on-accent);
    box-shadow: var(--glow-cta);
    transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }

  .btn-lg { font-size: var(--fs-body); padding: 0.85rem 1.8rem; }

  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 14px 50px -8px rgba(252,44,48,0.7), 0 0 0 1px rgba(252,44,48,0.4);
  }
</style>
