---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection } from 'astro:content';

const allServices = await getCollection('services');
const sorted = allServices.sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Services"
  description="Four ways we make people know you. Every engagement starts with the messaging, not the shot list."
>
  <section class="page-hero">
    <div class="inner">
      <div class="kicker">What we do</div>
      <h1 class="hero-title">Four ways we make<br>people know you.</h1>
      <p class="hero-body">We handle every phase of production, or step in where you need us most. Every engagement starts with the messaging, not the shot list.</p>
    </div>
  </section>

  <section class="services-section">
    <div class="inner">
      <div class="services-list">
        {sorted.map((entry) => {
          const numStr = String(entry.data.order).padStart(2, '0');
          const metaBits = (entry.data.specialties ?? entry.data.produces).slice(0, 3);
          if (entry.data.beta) metaBits.unshift('In beta');
          const meta = metaBits.join(' · ');
          return (
            <a href={`/services/${entry.id}`} class="svc-row">
              <div class="svc-row__num">{numStr}</div>
              <div class="svc-row__body">
                <h3 class="svc-row__title">
                  {entry.data.title}
                  {entry.data.beta && <span class="beta-pill">Beta</span>}
                </h3>
                <p class="svc-row__desc">{entry.data.summary}</p>
              </div>
              <div class="svc-row__meta">{meta}</div>
              <div class="svc-row__arrow" aria-hidden="true">→</div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <CtaBand
    heading="Not sure which one you need?"
    accentPhrase="Let's talk it through."
    body="Most projects start as one thing and turn into another. A twenty-minute call usually settles it."
    primaryLabel="Tell us about your project"
    primaryHref="/contact"
  />
</Base>

<style>
  .inner {
    max-width: 1080px;
    margin: 0 auto;
    padding-inline: var(--gutter);
  }

  /* Hero */
  .page-hero {
    padding: clamp(4.5rem, 9vw, 7rem) 0 2.5rem;
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-soft);
    margin-bottom: 20px;
  }

  .hero-title {
    font-size: clamp(2.6rem, 1.8rem + 3.4vw, 4rem);
    font-weight: var(--fw-black);
    letter-spacing: var(--tracking-display);
    line-height: 1.02;
    color: var(--text-strong);
    margin: 0 0 22px;
    max-width: 20ch;
    text-wrap: balance;
  }

  .hero-body {
    font-size: 1.12rem;
    line-height: 1.65;
    color: var(--text-muted);
    margin: 0;
    max-width: 58ch;
  }

  /* Services list */
  .services-section {
    padding-bottom: 5rem;
  }

  .services-list {
    border-top: 1px solid var(--border-subtle);
  }

  .svc-row {
    position: relative;
    display: grid;
    grid-template-columns: 74px minmax(0, 1fr) 210px 44px;
    gap: 28px;
    align-items: start;
    padding: 34px 20px 34px 8px;
    border-bottom: 1px solid var(--border-subtle);
    text-decoration: none;
    transition: background var(--dur-base) var(--ease-out), padding-left var(--dur-base) var(--ease-out);
  }

  .svc-row > * { min-width: 0; }

  .svc-row:hover {
    background: var(--surface-raised);
    padding-left: 22px;
  }

  .svc-row:hover .svc-row__title { color: var(--accent-soft); }
  .svc-row:hover .svc-row__arrow { transform: translateX(6px); opacity: 1; }
  .svc-row:hover .svc-row__meta { opacity: 1; }

  .svc-row__num {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    color: var(--text-faint);
    padding-top: 7px;
  }

  .svc-row__title {
    display: block;
    margin: 0 0 9px;
    font-size: 1.42rem;
    font-weight: var(--fw-black);
    letter-spacing: -0.02em;
    line-height: 1.22;
    color: var(--text-strong);
    transition: color var(--dur-base) ease;
  }

  .beta-pill {
    display: inline-block;
    vertical-align: middle;
    margin-left: 12px;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: var(--fw-regular);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-soft);
    border: 1px solid rgba(252,44,48,.4);
    background: rgba(252,44,48,.1);
    border-radius: var(--radius-pill);
    padding: 3px 9px;
  }

  .svc-row__desc {
    margin: 0;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.62;
    max-width: 52ch;
  }

  .svc-row__meta {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.85;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-faint);
    padding-top: 6px;
    opacity: 0.62;
    transition: opacity var(--dur-base) ease;
  }

  .svc-row__arrow {
    font-size: 1.5rem;
    color: var(--accent);
    padding-top: 2px;
    justify-self: end;
    opacity: 0.5;
    transition: transform var(--dur-base) var(--ease-out), opacity var(--dur-base) ease;
  }

  /* Responsive */
  @media (max-width: 1040px) {
    .svc-row {
      grid-template-columns: 74px minmax(0, 1fr) 44px;
    }
    .svc-row__meta { display: none; }
  }

  @media (max-width: 820px) {
    .svc-row {
      grid-template-columns: 52px minmax(0, 1fr) 30px;
      gap: 16px;
    }
  }
</style>
