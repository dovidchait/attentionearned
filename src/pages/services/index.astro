---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection } from 'astro:content';

const allServices = await getCollection('services');
const sorted = allServices.sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Services"
  description="Full-service video production for corporate, healthcare, nonprofit, and brand clients."
>
  <section class="services-page container">
    <h1>Services</h1>
    <p class="services-page__intro">
      We handle every phase of production. Or we step in where you need us most.
    </p>

    <div class="services-list">
      {sorted.map(entry => (
        <a href={`/services/${entry.id}`} class="service-row">
          <div class="service-row__body">
            <h2 class="service-row__title">{entry.data.title}</h2>
            <p class="service-row__desc">{entry.data.summary}</p>
          </div>
          <span class="service-row__arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <CtaBand
    heading="Not sure which service you need?"
    accentPhrase="Let's talk it through."
    primaryLabel="Tell us about your project"
    primaryHref="/contact"
  />
</Base>

<style>
  .services-page {
    max-width: 820px;
    padding-block: clamp(4rem, 8vw, 6rem) 4rem;
  }

  .services-page h1 {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    color: var(--text-strong);
    margin-bottom: 0.875rem;
  }

  .services-page__intro {
    font-size: 1.1rem;
    color: var(--text-muted);
    margin-bottom: 3rem;
    line-height: var(--lh-body);
  }

  .services-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border-subtle);
  }

  .service-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 1.625rem 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background var(--dur-base) var(--ease-out), padding-left var(--dur-base) var(--ease-out);
  }

  .service-row:hover {
    background: var(--surface-card);
    padding-left: calc(0.75rem + 16px);
  }

  .service-row__title {
    font-size: 1.3rem;
    font-weight: var(--fw-bold);
    color: var(--text-strong);
    margin-bottom: 0.375rem;
    letter-spacing: var(--tracking-tight);
  }

  .service-row__desc {
    color: var(--text-muted);
    font-size: 0.98rem;
    line-height: var(--lh-body);
    max-width: 56ch;
  }

  .service-row__arrow {
    font-size: 1.4rem;
    color: var(--accent-soft);
    flex-shrink: 0;
    padding-top: 4px;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .service-row:hover .service-row__arrow { transform: translateX(4px); }
</style>
