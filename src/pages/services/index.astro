---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allServices = await getCollection('services');
const sorted = allServices.sort((a, b) => a.data.order - b.data.order);
---

<Base title="Services" description="Full-service video production for corporate, healthcare, and nonprofit clients.">
  <section class="page-hero container">
    <h1>Services</h1>
    <p class="page-intro">
      We handle every phase of production. Or we step in where you need us most.
    </p>
  </section>

  <section class="container services-list-section">
    <div class="services-list">
      {sorted.map(entry => (
        <a href={`/services/${entry.id}`} class="service-item">
          <div class="service-item__body">
            <h2 class="service-item__title">{entry.data.title}</h2>
            <p class="service-item__summary">{entry.data.summary}</p>
          </div>
          <span class="service-item__arrow" aria-hidden="true">&#8594;</span>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .page-hero { padding-block: var(--space-16) var(--space-12); }
  .page-hero h1 { font-size: var(--text-5xl); }
  .page-intro {
    max-width: 60ch;
    color: var(--color-ink-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-loose);
    margin-top: var(--space-4);
  }
  .services-list-section { padding-bottom: var(--space-24); }
  .services-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-border);
  }
  .service-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-8);
    border-bottom: 1px solid var(--color-border);
    gap: var(--space-8);
    transition: background var(--transition-fast);
    padding-inline: var(--space-2);
    border-radius: var(--radius-sm);
  }
  .service-item:hover { background: var(--color-surface-alt); }
  .service-item__title { font-size: var(--text-2xl); }
  .service-item__summary {
    max-width: 52ch;
    color: var(--color-ink-muted);
    margin-top: var(--space-2);
    font-size: var(--text-base);
  }
  .service-item__arrow {
    font-size: var(--text-2xl);
    color: var(--color-accent);
    flex-shrink: 0;
    transition: transform var(--transition-fast);
  }
  .service-item:hover .service-item__arrow { transform: translateX(4px); }
</style>
