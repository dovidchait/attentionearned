---
import Base from '../layouts/Base.astro';

const FORMSPREE = 'https://formspree.io/f/xrbnvoqj';
---

<Base
  title="Contact"
  description="Start a video project with Attention Earned. Get a response within 24 hours."
>
  <section class="contact-section container">
    <div class="contact-header">
      <h1>Video that delivers results</h1>
      <p class="contact-intro">
        Whether you need to raise funds, build your brand, or tell a story
        that matters, let's create something that works. Tell me about your
        project and I'll get back to you within 24 hours.
      </p>
    </div>

    <form class="contact-form" action={FORMSPREE} method="POST" novalidate>
      <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
      <input type="hidden" name="_next" value="https://attentionearned.com/contact?sent=true" />

      <div class="form-grid">
        <div class="field">
          <label for="name" class="field__label">Name</label>
          <input id="name" type="text" name="name" class="field__input" required autocomplete="name" placeholder="Jane Smith" />
        </div>
        <div class="field">
          <label for="email" class="field__label">Email</label>
          <input id="email" type="email" name="email" class="field__input" required autocomplete="email" placeholder="jane@company.com" />
        </div>
        <div class="field">
          <label for="company" class="field__label">Company / Organization</label>
          <input id="company" type="text" name="company" class="field__input" autocomplete="organization" placeholder="Acme Corp" />
        </div>
        <div class="field">
          <label for="phone" class="field__label">Phone</label>
          <input id="phone" type="tel" name="phone" class="field__input" autocomplete="tel" placeholder="Optional" />
        </div>
        <div class="field field--full">
          <label for="timeline" class="field__label">Timeline</label>
          <input id="timeline" type="text" name="timeline" class="field__input" placeholder="When do you need this?" />
        </div>
        <div class="field field--full">
          <label for="message" class="field__label">Tell me about your project</label>
          <textarea id="message" name="message" class="field__input field__textarea" required rows="5" placeholder="What are you making, who will watch it, and what needs to happen after they watch it?"></textarea>
        </div>
        <div class="field field--full">
          <button type="submit" class="btn-submit">Send message</button>
        </div>
      </div>
    </form>

    <p class="contact-types">
      Project type: fundraising · testimonial · promotional · event coverage · documentary · social content · other
    </p>

    <p class="form-success" id="form-success-msg" aria-live="polite" style="display:none">
      Your message was sent. We'll be in touch shortly.
    </p>
  </section>
</Base>

<script>
  if (new URLSearchParams(window.location.search).get('sent') === 'true') {
    const msg = document.getElementById('form-success-msg');
    if (msg) {
      msg.style.display = 'block';
    }
    const url = new URL(window.location.href);
    url.searchParams.delete('sent');
    window.history.replaceState({}, '', url);
  }
</script>

<style>
  .contact-section {
    max-width: 820px;
    padding-block: clamp(4rem, 8vw, 6rem) 6rem;
  }

  .contact-header { margin-bottom: 2.75rem; }

  .contact-section h1 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    color: var(--text-strong);
    margin-bottom: 0.875rem;
  }

  .contact-intro {
    font-size: 1.1rem;
    color: var(--text-muted);
    line-height: var(--lh-body);
    max-width: 60ch;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  @media (max-width: 560px) { .form-grid { grid-template-columns: 1fr; } }

  .field { display: flex; flex-direction: column; gap: 0.4rem; }
  .field--full { grid-column: 1 / -1; }

  .field__label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .field__input {
    width: 100%;
    padding: 0.75rem 1rem;
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    color: var(--text-body);
    background: var(--surface-card);
    border: 1px solid var(--border-mid);
    border-radius: var(--radius-md);
    outline: none;
    transition: border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
    appearance: none;
  }

  .field__input::placeholder { color: var(--text-faint); }

  .field__input:focus {
    border-color: var(--accent-soft);
    box-shadow: 0 0 0 3px rgba(252, 106, 106, 0.15);
  }

  .field__textarea { resize: vertical; min-height: 130px; }

  .btn-submit {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 2rem;
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    font-weight: var(--fw-bold);
    color: var(--text-on-accent);
    background: var(--grad-cta);
    box-shadow: var(--glow-cta);
    border: none;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
    letter-spacing: 0.04em;
  }

  .btn-submit:hover {
    transform: translateY(-1px);
    box-shadow: 0 14px 50px -8px rgba(252,44,48,0.7), 0 0 0 1px rgba(252,44,48,0.4);
  }

  .contact-types {
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .form-success {
    margin-top: 1.25rem;
    padding: 1rem 1.25rem;
    background: rgba(79, 191, 139, 0.1);
    border: 1px solid rgba(79, 191, 139, 0.25);
    border-radius: var(--radius-md);
    color: var(--ok);
    font-size: var(--fs-sm);
  }
</style>
