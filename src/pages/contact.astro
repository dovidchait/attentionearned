---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Base title="Contact" description="Video that delivers results. Start a conversation with AttentionEarned.">
  <section class="contact-section container">
    <header class="contact-header">
      <h1>Video that delivers results</h1>
      <p class="contact-intro">
        Whether you need to raise funds, build your brand, or tell a story
        that matters, let's create something that works. Tell me about your
        project and I'll get back to you within 24 hours.
      </p>
    </header>

    <ContactForm />
  </section>
</Base>

<style>
  .contact-section { padding-block: var(--space-16) var(--space-24); }
  .contact-header { margin-bottom: var(--space-12); }
  .contact-header h1 { font-size: var(--text-5xl); }
  .contact-intro {
    max-width: 52ch;
    color: var(--color-ink-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-loose);
    margin-top: var(--space-4);
  }
</style>
