---
import Base from '../layouts/Base.astro';
---

<Base
  title="Video Pipeline — Attention Earned"
  description="Selfie video to scheduled post — transcript, captions, first comment."
  noindex={true}
  noNav={true}
  noFooter={true}
>
  <div class="tool">
    <header class="tool__header">
      <a href="https://attentionearned.com" class="tool__wordmark">
        <svg width="20" height="20" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect width="32" height="32" rx="6" fill="#FC2C30"/>
          <path d="M8 24L16 8L24 24" stroke="#FBF8F1" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M11 19H21" stroke="#FBF8F1" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
        <span>Attention Earned</span>
      </a>
      <h1>Video Pipeline</h1>
      <p class="tool__tagline">Paste your video link. Get a transcript, catch misheard words, and have captions ready to post.</p>
    </header>

    <form class="tool__form" id="pipelineForm">
      <div class="field">
        <label for="videoUrl">Video URL <span class="required">*</span></label>
        <input
          type="url"
          id="videoUrl"
          name="videoUrl"
          placeholder="YouTube, Dropbox (dl=1), Google Drive, WeTransfer, or any direct .mp4 link"
          required
          autocomplete="off"
        />
        <span class="field__hint">Dropbox: change <code>?dl=0</code> to <code>?dl=1</code> in the link</span>
      </div>

      <div class="field-row">
        <div class="field">
          <label for="orgName">Organization name</label>
          <input type="text" id="orgName" name="orgName" placeholder="e.g. Chabad of Miami" />
        </div>
        <div class="field field--short">
          <label for="dayNumber">Day #</label>
          <input type="number" id="dayNumber" name="dayNumber" placeholder="1" min="1" max="30" value="1" />
        </div>
      </div>

      <div class="field">
        <label for="credits">People to credit</label>
        <input type="text" id="credits" name="credits" placeholder="e.g. Rabbi Levi Goldstein, Sarah Cohen" />
        <span class="field__hint">First names will appear in captions — handles are never guessed</span>
      </div>

      <div class="field">
        <label for="vocab">Domain-specific words</label>
        <input type="text" id="vocab" name="vocab" placeholder="e.g. yeshiva, shiur, Shabbos, Chabad" />
        <span class="field__hint">Comma-separated — these get a boost in transcription accuracy</span>
      </div>

      <button type="submit" class="btn btn--primary" id="submitBtn">
        <span class="btn__label">Process video</span>
        <svg class="btn__arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8H13M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </form>

    <!-- Processing state -->
    <div class="status" id="statusPanel" hidden>
      <div class="status__spinner" aria-hidden="true"></div>
      <p class="status__text" id="statusText">Submitting…</p>
    </div>

    <!-- Error state -->
    <div class="error-panel" id="errorPanel" hidden>
      <p id="errorText"></p>
      <button class="btn btn--ghost" id="resetBtn">Try again</button>
    </div>

    <!-- Results -->
    <div class="results" id="resultsPanel" hidden>

      <!-- Flagged words -->
      <div class="flagged-section" id="flaggedSection" hidden>
        <h2 class="section-title">
          <span class="badge badge--warn">Review</span>
          Low-confidence words
        </h2>
        <p class="section-desc">These words scored below 40% confidence. Correct them in the transcript below before copying captions.</p>
        <div class="flagged-list" id="flaggedList"></div>
      </div>

      <!-- Transcript -->
      <details class="transcript-details">
        <summary class="section-title">Full transcript</summary>
        <div class="transcript-body" id="transcriptText"></div>
      </details>

      <!-- Instagram / TikTok caption -->
      <div class="caption-card">
        <div class="caption-card__header">
          <h2 class="section-title">Instagram &amp; TikTok caption</h2>
          <button class="btn btn--copy" data-target="instagramCaption" title="Copy">
            <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
              <rect x="5" y="5" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.3"/>
              <path d="M3 10V3a1 1 0 011-1h7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
            </svg>
            <span>Copy</span>
          </button>
        </div>
        <textarea class="caption-textarea" id="instagramCaption" rows="8" spellcheck="true"></textarea>
      </div>

      <!-- LinkedIn caption -->
      <div class="caption-card">
        <div class="caption-card__header">
          <h2 class="section-title">LinkedIn caption</h2>
          <button class="btn btn--copy" data-target="linkedinCaption" title="Copy">
            <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
              <rect x="5" y="5" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.3"/>
              <path d="M3 10V3a1 1 0 011-1h7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
            </svg>
            <span>Copy</span>
          </button>
        </div>
        <textarea class="caption-textarea" id="linkedinCaption" rows="8" spellcheck="true"></textarea>
      </div>

      <!-- First comment -->
      <div class="caption-card caption-card--sm">
        <div class="caption-card__header">
          <h2 class="section-title">First comment</h2>
          <button class="btn btn--copy" data-target="firstComment" title="Copy">
            <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
              <rect x="5" y="5" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.3"/>
              <path d="M3 10V3a1 1 0 011-1h7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
            </svg>
            <span>Copy</span>
          </button>
        </div>
        <textarea class="caption-textarea caption-textarea--sm" id="firstComment" rows="2" spellcheck="true"></textarea>
      </div>

      <button class="btn btn--ghost" id="startOverBtn">Process another video</button>
    </div>

    <footer class="tool__footer">
      <a href="https://attentionearned.com">attentionearned.com</a>
    </footer>
  </div>
</Base>

<script>
  const form = document.getElementById('pipelineForm') as HTMLFormElement;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
  const statusPanel = document.getElementById('statusPanel') as HTMLElement;
  const statusText = document.getElementById('statusText') as HTMLElement;
  const errorPanel = document.getElementById('errorPanel') as HTMLElement;
  const errorText = document.getElementById('errorText') as HTMLElement;
  const resultsPanel = document.getElementById('resultsPanel') as HTMLElement;
  const flaggedSection = document.getElementById('flaggedSection') as HTMLElement;
  const flaggedList = document.getElementById('flaggedList') as HTMLElement;
  const transcriptText = document.getElementById('transcriptText') as HTMLElement;
  const instagramCaption = document.getElementById('instagramCaption') as HTMLTextAreaElement;
  const linkedinCaption = document.getElementById('linkedinCaption') as HTMLTextAreaElement;
  const firstComment = document.getElementById('firstComment') as HTMLTextAreaElement;

  let pollInterval: ReturnType<typeof setInterval> | null = null;
  let pollCount = 0;
  const MAX_POLLS = 60; // 5 minutes at 5s intervals

  function show(el: HTMLElement) { el.hidden = false; }
  function hide(el: HTMLElement) { el.hidden = true; }

  function reset() {
    if (pollInterval) { clearInterval(pollInterval); pollInterval = null; }
    pollCount = 0;
    hide(statusPanel);
    hide(errorPanel);
    hide(resultsPanel);
    show(form);
    submitBtn.disabled = false;
    submitBtn.querySelector('.btn__label')!.textContent = 'Process video';
  }

  function showError(msg: string) {
    if (pollInterval) { clearInterval(pollInterval); pollInterval = null; }
    hide(statusPanel);
    errorText.textContent = msg;
    show(errorPanel);
  }

  function showResults(data: {
    transcript: string;
    flagged: Array<{ text: string; confidence: number }>;
    instagram: string;
    linkedin: string;
    firstComment: string;
  }) {
    hide(statusPanel);

    transcriptText.textContent = data.transcript;
    instagramCaption.value = data.instagram;
    linkedinCaption.value = data.linkedin;
    firstComment.value = data.firstComment;

    if (data.flagged.length > 0) {
      flaggedList.innerHTML = data.flagged
        .map(w => `<span class="flagged-word">${w.text} <em>${w.confidence}%</em></span>`)
        .join('');
      show(flaggedSection);
    } else {
      hide(flaggedSection);
    }

    show(resultsPanel);
    resultsPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  async function pollResult(jobId: string, orgName: string, dayNumber: string, credits: string) {
    pollCount++;
    if (pollCount > MAX_POLLS) {
      showError('Timed out after 5 minutes. Please try again.');
      return;
    }

    const params = new URLSearchParams({ jobId, orgName, dayNumber, credits });
    let data: { status: string; error?: string; transcript?: string; flagged?: Array<{ text: string; confidence: number }>; instagram?: string; linkedin?: string; firstComment?: string };

    try {
      const res = await fetch(`/api/content/result?${params}`);
      data = await res.json();
    } catch {
      showError('Network error while checking status. Please try again.');
      return;
    }

    if (data.status === 'error') {
      showError(data.error ?? 'Transcription failed.');
      return;
    }

    if (data.status === 'queued') {
      statusText.textContent = 'In queue…';
      return;
    }

    if (data.status === 'processing') {
      statusText.textContent = 'Transcribing…';
      return;
    }

    if (data.status === 'completed') {
      if (pollInterval) { clearInterval(pollInterval); pollInterval = null; }
      showResults(data as Parameters<typeof showResults>[0]);
      return;
    }
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    reset();

    const fd = new FormData(form);
    const videoUrl = (fd.get('videoUrl') as string).trim();
    const orgName = (fd.get('orgName') as string).trim();
    const dayNumber = (fd.get('dayNumber') as string).trim() || '1';
    const credits = (fd.get('credits') as string).trim();
    const vocab = (fd.get('vocab') as string).trim();
    const wordBoost = vocab ? vocab.split(',').map(s => s.trim()).filter(Boolean) : [];

    hide(form);
    show(statusPanel);
    statusText.textContent = 'Submitting…';

    let jobId: string;
    try {
      const res = await fetch('/api/content/start', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ videoUrl, wordBoost }),
      });
      const data = await res.json() as { jobId?: string; error?: string };
      if (!res.ok || !data.jobId) {
        showError(data.error ?? 'Could not start transcription.');
        show(form);
        return;
      }
      jobId = data.jobId;
    } catch {
      showError('Network error. Please check your connection and try again.');
      show(form);
      return;
    }

    statusText.textContent = 'In queue…';
    pollInterval = setInterval(() => pollResult(jobId, orgName, dayNumber, credits), 5000);
    // Poll once immediately after a short delay
    setTimeout(() => pollResult(jobId, orgName, dayNumber, credits), 2000);
  });

  document.getElementById('resetBtn')!.addEventListener('click', () => { reset(); });
  document.getElementById('startOverBtn')!.addEventListener('click', () => { reset(); show(form); });

  // Copy buttons
  document.querySelectorAll<HTMLButtonElement>('.btn--copy').forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.dataset.target!;
      const textarea = document.getElementById(targetId) as HTMLTextAreaElement;
      navigator.clipboard.writeText(textarea.value).then(() => {
        const label = btn.querySelector('span')!;
        label.textContent = 'Copied!';
        btn.classList.add('btn--copied');
        setTimeout(() => {
          label.textContent = 'Copy';
          btn.classList.remove('btn--copied');
        }, 2000);
      });
    });
  });
</script>

<style>
  .tool {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    max-width: 680px;
    margin-inline: auto;
    padding: var(--space-7) var(--gutter) var(--space-9);
    gap: var(--space-7);
  }

  .tool__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .tool__wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    color: var(--text-muted);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .tool__wordmark:hover { color: var(--text-body); }

  .tool__header h1 {
    font-size: var(--fs-h1);
    letter-spacing: var(--tracking-display);
    color: var(--text-strong);
  }

  .tool__tagline {
    color: var(--text-muted);
    font-size: var(--fs-body-lg);
    max-width: 52ch;
  }

  /* Form */
  .tool__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-4);
    align-items: start;
  }

  .field--short { width: 100px; }

  label {
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    color: var(--text-body);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .required { color: var(--ae-red); }

  input[type="text"],
  input[type="url"],
  input[type="number"] {
    width: 100%;
    background: var(--surface-card);
    border: 1px solid var(--border-mid);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
    color: var(--text-strong);
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    transition: border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
    outline: none;
  }

  input:focus {
    border-color: var(--ae-red);
    box-shadow: 0 0 0 3px rgba(252, 44, 48, 0.15);
  }

  input::placeholder { color: var(--text-faint); }

  .field__hint {
    font-size: var(--fs-xs);
    color: var(--text-faint);
  }
  .field__hint code {
    font-family: var(--font-mono);
    background: var(--surface-inset);
    padding: 1px 5px;
    border-radius: 4px;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    font-weight: var(--fw-semibold);
    cursor: pointer;
    border: none;
    transition: background var(--dur-fast) var(--ease-out), opacity var(--dur-fast) var(--ease-out);
  }

  .btn--primary {
    background: var(--ae-red);
    color: #fff;
    align-self: flex-start;
  }
  .btn--primary:hover { background: var(--ae-red-press); }
  .btn--primary:disabled { opacity: 0.5; cursor: not-allowed; }

  .btn--ghost {
    background: transparent;
    color: var(--text-muted);
    border: 1px solid var(--border-mid);
    padding: var(--space-2) var(--space-4);
    font-size: var(--fs-sm);
  }
  .btn--ghost:hover { color: var(--text-body); border-color: var(--border-strong); }

  .btn--copy {
    background: var(--surface-inset);
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
    padding: var(--space-1) var(--space-3);
    font-size: var(--fs-xs);
    border-radius: var(--radius-xs);
  }
  .btn--copy:hover { color: var(--text-body); }
  .btn--copied { color: var(--ok) !important; border-color: var(--ok) !important; }

  /* Status */
  .status {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--surface-card);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }

  .status__spinner {
    width: 20px;
    height: 20px;
    border: 2px solid var(--border-mid);
    border-top-color: var(--ae-red);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    flex-shrink: 0;
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  .status__text {
    color: var(--text-muted);
    font-size: var(--fs-body);
  }

  /* Error */
  .error-panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-5);
    background: rgba(252, 44, 48, 0.08);
    border: 1px solid rgba(252, 44, 48, 0.25);
    border-radius: var(--radius-md);
    color: var(--ae-coral);
  }

  /* Results */
  .results {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    animation: aeRise 0.5s var(--ease-out) both;
  }

  .section-title {
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .section-desc {
    font-size: var(--fs-sm);
    color: var(--text-faint);
    margin-top: var(--space-2);
  }

  .badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-label);
  }
  .badge--warn { background: rgba(233, 185, 73, 0.15); color: var(--warn); border: 1px solid rgba(233, 185, 73, 0.3); }

  .flagged-section { display: flex; flex-direction: column; }

  .flagged-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .flagged-word {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: var(--space-1) var(--space-3);
    background: rgba(233, 185, 73, 0.1);
    border: 1px solid rgba(233, 185, 73, 0.25);
    border-radius: var(--radius-pill);
    font-size: var(--fs-sm);
    color: var(--warn);
  }
  .flagged-word em {
    font-style: normal;
    font-size: var(--fs-xs);
    opacity: 0.7;
  }

  /* Transcript */
  .transcript-details {
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }
  .transcript-details summary {
    padding: var(--space-4) var(--space-5);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .transcript-details summary::-webkit-details-marker { display: none; }
  .transcript-details summary::after {
    content: '▸';
    float: right;
    color: var(--text-faint);
    transition: transform var(--dur-fast);
  }
  .transcript-details[open] summary::after { transform: rotate(90deg); }

  .transcript-body {
    padding: var(--space-4) var(--space-5) var(--space-5);
    border-top: 1px solid var(--border-subtle);
    font-size: var(--fs-sm);
    color: var(--text-muted);
    line-height: var(--lh-body);
    white-space: pre-wrap;
  }

  /* Caption cards */
  .caption-card {
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .caption-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--border-subtle);
  }

  .caption-textarea {
    width: 100%;
    background: transparent;
    border: none;
    padding: var(--space-4) var(--space-5);
    color: var(--text-body);
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    resize: vertical;
    outline: none;
  }

  .caption-textarea--sm { rows: 2; }

  /* Footer */
  .tool__footer {
    margin-top: auto;
    padding-top: var(--space-7);
    font-size: var(--fs-xs);
    color: var(--text-faint);
    text-align: center;
  }
  .tool__footer a:hover { color: var(--text-muted); }

  @media (max-width: 480px) {
    .field-row { grid-template-columns: 1fr; }
    .field--short { width: 100%; }
  }
</style>
