---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
---

<Base
  title="Video for Nonprofits"
  description="Four ways Attention Earned helps nonprofits get their video working — from a single clip posted everywhere to a full campaign rollout."
>
  <section class="page-hero">
    <div class="inner">
      <div class="kicker">For nonprofits</div>
      <h1 class="hero-title">Four ways we get your video working.</h1>
      <p class="hero-body">
        Most organizations have video sitting unused, or a campaign coming up
        and no plan for the content. Here's what an engagement actually looks like.
      </p>
    </div>
  </section>

  <section class="offers-section">
    <div class="inner">

      <div class="offer-card offer-card--featured">
        <div class="offer-card__num">01</div>
        <div class="offer-card__body">
          <h2 class="offer-card__title">Text to Attention</h2>
          <p class="offer-card__desc">
            Send us your clips and a voice note on WhatsApp or email. We edit
            them into short videos with captions in your brand, schedule them
            to your social accounts, and send you the live links.
          </p>
          <p class="offer-card__for">
            <span class="for-label">Good for:</span>
            Organizations with footage they've never done anything with, or founders
            who film on their phones and stop there.
          </p>
          <p class="offer-card__proof">
            <a href="/text-to-attention" class="proof-link">How Text to Attention works →</a>
          </p>
          <div class="offer-card__footer">
            <a href="/contact?ref=text-to-attention" class="ae-btn ae-btn--primary ae-btn--md">Send us your video</a>
          </div>
        </div>
      </div>

      <div class="offer-card">
        <div class="offer-card__num">02</div>
        <div class="offer-card__body">
          <h2 class="offer-card__title">Campaign Rollout</h2>
          <p class="offer-card__desc">
            A fundraising campaign needs more than a main video. We build the
            arc: teaser, main video, case study, status cuts — timed around
            your campaign calendar so each piece does a specific job.
          </p>
          <p class="offer-card__for">
            <span class="for-label">Good for:</span>
            Nonprofits running an annual campaign or a major push where the
            goal is measured in dollars raised, not views.
          </p>
          <p class="offer-card__proof">
            <a href="/work/meoros-2026" class="proof-link">See how this worked for a $400K campaign →</a>
          </p>
          <div class="offer-card__footer">
            <a href="/contact?ref=campaign-rollout" class="ae-btn ae-btn--primary ae-btn--md">Tell us about your campaign</a>
          </div>
        </div>
      </div>

      <div class="offer-card">
        <div class="offer-card__num">03</div>
        <div class="offer-card__body">
          <h2 class="offer-card__title">WhatsApp Status Pack</h2>
          <p class="offer-card__desc">
            Short vertical cuts made specifically for WhatsApp status. Your
            community sees them inside the app they already use — not on a
            social feed they might not follow.
          </p>
          <p class="offer-card__for">
            <span class="for-label">Good for:</span>
            Organizations where WhatsApp is the actual communication channel —
            not a side project.
          </p>
          <div class="offer-card__footer">
            <a href="/contact?ref=whatsapp-status-pack" class="ae-btn ae-btn--primary ae-btn--md">Get the details</a>
          </div>
        </div>
      </div>

      <div class="offer-card">
        <div class="offer-card__num">04</div>
        <div class="offer-card__body">
          <h2 class="offer-card__title">Posting, Handled</h2>
          <p class="offer-card__desc">
            Between campaigns, video keeps working if it's being posted.
            We schedule, post, and recycle existing content across platforms
            so you stay visible without anyone on your team adding work.
          </p>
          <p class="offer-card__for">
            <span class="for-label">Good for:</span>
            Organizations that produce content periodically but don't have
            the bandwidth to keep it distributed.
          </p>
          <div class="offer-card__footer">
            <a href="/contact?ref=posting-handled" class="ae-btn ae-btn--primary ae-btn--md">Let's talk</a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <CtaBand
    heading="Not sure which one fits?"
    accentPhrase="Tell us what you have."
    body="Most projects start as one thing and turn into something more specific. A short conversation usually sorts it out."
    primaryLabel="Start the conversation"
    primaryHref="/contact"
  />
</Base>

<style>
  .inner {
    max-width: 860px;
    margin: 0 auto;
    padding-inline: var(--gutter);
  }

  /* Hero */
  .page-hero {
    padding: clamp(4.5rem, 9vw, 7rem) 0 2.5rem;
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-soft);
    margin-bottom: 20px;
  }

  .hero-title {
    font-size: clamp(2.4rem, 1.6rem + 3vw, 3.6rem);
    font-weight: var(--fw-black);
    letter-spacing: var(--tracking-display);
    line-height: 1.05;
    color: var(--text-strong);
    margin: 0 0 22px;
    max-width: 22ch;
    text-wrap: balance;
  }

  .hero-body {
    font-size: 1.12rem;
    line-height: 1.65;
    color: var(--text-muted);
    margin: 0;
    max-width: 58ch;
  }

  /* Offers */
  .offers-section {
    padding-bottom: 5rem;
  }

  .offer-card {
    display: grid;
    grid-template-columns: 74px 1fr;
    gap: 32px;
    padding: 2.5rem 0;
    border-top: 1px solid var(--border-subtle);
    align-items: start;
  }

  .offer-card--featured {
    border-top-color: var(--accent);
  }

  .offer-card__num {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    color: var(--text-faint);
    padding-top: 6px;
  }

  .offer-card--featured .offer-card__num {
    color: var(--accent-soft);
  }

  .offer-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .offer-card__title {
    font-size: 1.65rem;
    font-weight: var(--fw-black);
    letter-spacing: -0.02em;
    line-height: 1.18;
    color: var(--text-strong);
    margin: 0;
  }

  .offer-card__desc {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-body);
    max-width: 60ch;
    margin: 0;
  }

  .offer-card__for {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .for-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-right: 0.5rem;
  }

  .offer-card__proof {
    margin: 0;
  }

  .proof-link {
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    color: var(--accent-soft);
    text-decoration: none;
    transition: color var(--dur-fast);
  }

  .proof-link:hover {
    color: var(--accent);
  }

  .offer-card__footer {
    padding-top: 0.25rem;
  }

  /* Button styles */
  .ae-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-weight: var(--fw-bold);
    border-radius: var(--radius-pill);
    border: none;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
    transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }

  .ae-btn--md {
    font-size: var(--fs-sm);
    padding: 0.65rem 1.4rem;
    letter-spacing: 0.03em;
  }

  .ae-btn--primary {
    background: var(--grad-cta);
    color: var(--text-on-accent);
    box-shadow: var(--glow-cta);
  }

  .ae-btn--primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 14px 50px -8px rgba(252, 44, 48, 0.7), 0 0 0 1px rgba(252, 44, 48, 0.4);
  }

  @media (max-width: 640px) {
    .offer-card {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .offer-card__num {
      padding-top: 0;
    }
  }
</style>
