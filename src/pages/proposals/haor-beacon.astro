---
import Base from '../../layouts/Base.astro';
---

<Base
  title="Ha'Or Beacon School — Fundraising Video Proposal"
  description="Fundraising video proposal from AttentionEarned for Ha'Or Beacon School."
  noindex={true}
  noNav={true}
  noFooter={true}
>
  <div class="proposal-wrap">

    <header class="prop-header">
      <div class="prop-header__inner">
        <a href="/" aria-label="Attention Earned home">
          <img src="/wordmark-white.svg" alt="Attention Earned" height="18" width="148" />
        </a>
        <span class="prop-header__label">Proposal · Confidential</span>
      </div>
    </header>

    <div class="prop-body container">

      <!-- Title block -->
      <section class="title-block ae-reveal">
        <p class="eyebrow">Fundraising Video Proposal</p>
        <h1 class="title-block__h1">
          A film for<br />
          <span class="accent-text">Ha'Or Beacon School</span>
        </h1>
        <dl class="meta-row">
          <div class="meta-item">
            <dt>Prepared for</dt>
            <dd>Chananya Berman, Ha'Or Beacon School</dd>
          </div>
          <div class="meta-item">
            <dt>Prepared by</dt>
            <dd>Dovid Chait, AttentionEarned</dd>
          </div>
          <div class="meta-item">
            <dt>Date</dt>
            <dd>August 28, 2026</dd>
          </div>
        </dl>
      </section>

      <div class="divider"></div>

      <!-- Overview -->
      <section class="section">
        <h2 class="section__title">Overview</h2>
        <div class="prose-block">
          <p>
            Over the next few weeks your school will pass through three defining moments: the dedication of your new building, the first day of school in that new space, and your Meet the Teacher Night with parents. This proposal covers all three on camera and shapes the footage into one polished fundraising video that shows donors both the building they helped create and the life now happening inside it.
          </p>
          <p class="aside">Plus it might be the last time the walls are clean.</p>
        </div>
      </section>

      <div class="divider"></div>

      <!-- Production Schedule -->
      <section class="section">
        <h2 class="section__title">Production Schedule</h2>
        <div class="timeline">
          <div class="timeline__item">
            <span class="timeline__date">Wednesday, September 2, 2026</span>
            <div class="timeline__content">
              <strong class="timeline__event">Mini Chanukas Habayis</strong>
              <p class="timeline__desc">Staff-only dedication for the new building. Coverage of the ceremony and the space itself.</p>
            </div>
          </div>
          <div class="timeline__item">
            <span class="timeline__date">Tuesday, September 8, 2026</span>
            <div class="timeline__content">
              <strong class="timeline__event">First Day of School</strong>
              <p class="timeline__desc">B-roll of students starting the year in the new building.</p>
            </div>
          </div>
          <div class="timeline__item">
            <span class="timeline__date">Wednesday, September 16, 2026 — Evening</span>
            <div class="timeline__content">
              <strong class="timeline__event">Meet the Teacher Night</strong>
              <p class="timeline__desc">Short, natural on-camera moments with parents about their experience with the school, captured as they come through — not as formal sit-down interviews.</p>
            </div>
          </div>
        </div>
      </section>

      <div class="divider"></div>

      <!-- Package Options -->
      <section class="section">
        <h2 class="section__title">Package Options</h2>
        <div class="packages">

          <div class="package package--featured">
            <div class="package__badge">Full Package</div>
            <div class="package__head">
              <span class="package__label">Option A</span>
              <h3 class="package__name">Complete Donor Toolkit</h3>
              <p class="package__sub">Best suited for a school that wants a complete donor-ready toolkit from this production.</p>
            </div>
            <ul class="package__features">
              <li>Three production days, crew and equipment included</li>
              <li>One polished fundraising video, 3–5 minutes, with motion graphics, licensed music, and color</li>
              <li>Aerial drone footage of the new building</li>
              <li>Extended cut for major donor meetings</li>
              <li>Short version sized for WhatsApp and community sharing</li>
              <li>All raw footage delivered</li>
            </ul>
            <div class="package__footer">
              <span class="package__price">$9,500</span>
            </div>
          </div>

          <div class="package">
            <div class="package__head">
              <span class="package__label">Option B</span>
              <h3 class="package__name">Core Package</h3>
              <p class="package__sub">A tighter scope built around one strong central piece.</p>
            </div>
            <ul class="package__features">
              <li>Three production days, crew and equipment included</li>
              <li>One polished fundraising video, 3–5 minutes, with motion graphics, licensed music, and color</li>
              <li>All raw footage delivered</li>
            </ul>
            <div class="package__footer">
              <span class="package__price">$6,500</span>
            </div>
          </div>

        </div>

        <div class="alt-option">
          <span class="alt-option__text">Prefer two production days instead of three? The Core Package is available at a reduced rate.</span>
          <span class="alt-option__price">$5,500</span>
        </div>
      </section>

      <div class="divider"></div>

      <!-- Payment Terms -->
      <section class="section">
        <h2 class="section__title">Payment Terms</h2>
        <div class="payment-grid">
          <div class="payment-step">
            <span class="payment-step__fraction">⅓</span>
            <p class="payment-step__label">Due upon signing</p>
          </div>
          <div class="payment-step">
            <span class="payment-step__fraction">⅓</span>
            <p class="payment-step__label">Due on the first production day — September 2, 2026</p>
          </div>
          <div class="payment-step">
            <span class="payment-step__fraction">⅓</span>
            <p class="payment-step__label">Due upon final delivery</p>
          </div>
        </div>
      </section>

      <div class="divider"></div>

      <!-- Footer -->
      <footer class="prop-footer">
        <span class="prop-footer__name">Dovid Chait · AttentionEarned</span>
        <a href="https://attentionearned.com" class="prop-footer__site">attentionearned.com</a>
      </footer>

    </div>
  </div>
</Base>

<style>
  .proposal-wrap {
    min-height: 100vh;
    background: var(--surface-base);
    color: var(--text-body);
  }

  /* ── Header ── */
  .prop-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(14,14,12,0.80);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .prop-header__inner {
    max-width: 860px;
    margin-inline: auto;
    padding: 16px var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .prop-header__inner img { height: 18px; width: auto; }

  .prop-header__label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--stone-400);
  }

  /* ── Body ── */
  .prop-body {
    max-width: 860px;
    padding-block: 72px 96px;
  }

  /* ── Title block ── */
  .title-block {
    margin-bottom: 56px;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ae-coral);
    margin-bottom: 20px;
  }

  .title-block__h1 {
    font-size: clamp(2.6rem, 6vw, 4rem);
    font-weight: var(--fw-black);
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-display);
    color: var(--text-strong);
    text-wrap: balance;
    margin-bottom: 36px;
  }

  .accent-text { color: var(--ae-coral); }

  .meta-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem 2rem;
    padding-top: 24px;
    border-top: 1px solid var(--border-mid);
  }

  @media (max-width: 560px) {
    .meta-row { grid-template-columns: 1fr; }
  }

  .meta-item dt {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--stone-400);
    margin-bottom: 4px;
  }

  .meta-item dd {
    font-size: 14px;
    color: var(--stone-300);
    line-height: 1.45;
  }

  /* ── Divider ── */
  .divider {
    height: 1px;
    background: var(--border-subtle);
    margin-block: 52px;
  }

  /* ── Section ── */
  .section__title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: var(--fw-black);
    letter-spacing: var(--tracking-display);
    color: var(--text-strong);
    margin-bottom: 28px;
  }

  /* ── Prose ── */
  .prose-block p {
    font-size: 16px;
    line-height: 1.75;
    color: var(--stone-300);
    max-width: 65ch;
  }

  .prose-block p + p { margin-top: 16px; }

  .aside {
    color: var(--stone-400) !important;
    font-style: italic;
  }

  /* ── Timeline ── */
  .timeline { display: flex; flex-direction: column; }

  .timeline__item {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 24px;
    padding: 24px 0;
    border-bottom: 1px solid var(--border-subtle);
    align-items: start;
  }

  .timeline__item:last-child { border-bottom: none; }

  @media (max-width: 580px) {
    .timeline__item { grid-template-columns: 1fr; gap: 8px; }
  }

  .timeline__date {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--ae-coral);
    padding-top: 2px;
    line-height: 1.5;
  }

  .timeline__event {
    display: block;
    font-size: 15px;
    font-weight: var(--fw-bold);
    color: var(--text-strong);
    margin-bottom: 6px;
    letter-spacing: -0.01em;
  }

  .timeline__desc {
    font-size: 14px;
    color: var(--stone-300);
    line-height: 1.65;
    margin: 0;
  }

  /* ── Packages ── */
  .packages {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 16px;
  }

  @media (max-width: 600px) { .packages { grid-template-columns: 1fr; } }

  .package {
    background: var(--surface-card);
    border: 1px solid var(--border-mid);
    border-radius: var(--radius-card);
    padding: 28px 24px 24px;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: var(--shadow-card);
  }

  .package--featured {
    border-color: rgba(252,106,106,0.35);
    box-shadow: var(--shadow-card), 0 0 40px -16px rgba(252,44,48,0.18);
  }

  .package__badge {
    position: absolute;
    top: -11px;
    left: 20px;
    background: var(--grad-cta);
    color: var(--text-on-accent);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    box-shadow: var(--glow-cta);
  }

  .package__label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--stone-400);
    display: block;
    margin-bottom: 8px;
  }

  .package__name {
    font-size: 1.2rem;
    font-weight: var(--fw-black);
    letter-spacing: -0.02em;
    color: var(--text-strong);
    margin-bottom: 6px;
    line-height: var(--lh-tight);
  }

  .package__sub {
    font-size: 13px;
    color: var(--stone-400);
    line-height: 1.55;
    margin: 0 0 20px;
  }

  .package__head { margin-bottom: 4px; }

  .package__features {
    list-style: none;
    flex: 1;
    margin-bottom: 24px;
  }

  .package__features li {
    font-size: 13.5px;
    color: var(--stone-300);
    padding: 8px 0;
    border-bottom: 1px solid var(--border-subtle);
    line-height: 1.5;
    display: flex;
    gap: 10px;
    align-items: baseline;
  }

  .package__features li:last-child { border-bottom: none; }

  .package__features li::before {
    content: '–';
    color: var(--ae-red);
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .package__footer {
    padding-top: 16px;
    border-top: 1px solid var(--border-mid);
  }

  .package__price {
    font-family: var(--font-mono);
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-strong);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  /* ── Alt option ── */
  .alt-option {
    background: var(--surface-raised);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 18px 22px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .alt-option__text {
    font-size: 14px;
    color: var(--stone-300);
    flex: 1;
    min-width: 180px;
    line-height: 1.5;
  }

  .alt-option__price {
    font-family: var(--font-mono);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-strong);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }

  /* ── Payment ── */
  .payment-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  @media (max-width: 520px) { .payment-grid { grid-template-columns: 1fr; } }

  .payment-step {
    background: var(--surface-card);
    border: 1px solid var(--border-mid);
    border-radius: var(--radius-md);
    padding: 22px 20px;
    box-shadow: var(--shadow-card);
  }

  .payment-step__fraction {
    display: block;
    font-family: var(--font-mono);
    font-size: 2.2rem;
    color: var(--ae-coral);
    line-height: 1;
    margin-bottom: 10px;
  }

  .payment-step__label {
    font-size: 13.5px;
    color: var(--stone-300);
    line-height: 1.55;
    margin: 0;
  }

  /* ── Page footer ── */
  .prop-footer {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .prop-footer__name {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--stone-400);
    letter-spacing: 0.04em;
  }

  .prop-footer__site {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--stone-400);
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: color var(--dur-fast);
  }

  .prop-footer__site:hover { color: var(--stone-300); }
</style>
