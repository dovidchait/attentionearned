---
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import CtaBand from '../../components/CtaBand.astro';
import { AE_WORK, getMediaFor, getPlatformLabel, MDX_SLUG_MAP } from '../../data/work';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const workEntries = await getCollection('work');
  const workById = Object.fromEntries(workEntries.map(e => [e.id, e]));

  return AE_WORK.map((entry, idx) => {
    const mdxId = MDX_SLUG_MAP[entry.slug];
    const mdxEntry = mdxId ? workById[mdxId] : undefined;
    const nextEntry = AE_WORK[(idx + 1) % AE_WORK.length];
    return {
      params: { slug: entry.slug },
      props: { entry, mdxEntry, nextEntry },
    };
  });
};

const { entry, mdxEntry, nextEntry } = Astro.props;
const media = getMediaFor(entry);
const platform = getPlatformLabel(entry);

let Content: ((_: Record<string, unknown>) => unknown) | null = null;
if (mdxEntry) {
  const rendered = await render(mdxEntry);
  Content = rendered.Content;
}
---

<Base title={entry.title} description={`${entry.sector} video: ${entry.title}${entry.client ? ` for ${entry.client}` : ''}`}>
  <article class="work-detail container">
    <div class="work-detail__meta">
      <Badge tone="accent">{entry.sector}</Badge>
    </div>
    <h1 class="work-detail__title">{entry.title}</h1>
    {entry.client && <p class="work-detail__client">{entry.client}</p>}

    <div class="work-detail__media">
      {media.type === 'video' && (
        <video controls src={media.src} class="work-detail__video" />
      )}
      {media.type === 'iframe' && (
        <iframe
          src={media.src}
          allow="autoplay; fullscreen; picture-in-picture"
          allowfullscreen
          class="work-detail__iframe"
          title={entry.title}
        />
      )}
      {media.type === 'link' && (
        <a href={media.src} target="_blank" rel="noopener noreferrer" class="work-detail__link-out">
          <span>View on {platform}</span>
          <span aria-hidden="true">→</span>
        </a>
      )}
    </div>

    <p class="work-detail__source">Source: {platform}</p>

    <div class="work-detail__body prose">
      {Content
        ? <Content />
        : <p class="placeholder">Full case study coming soon.</p>
      }
    </div>

    <nav class="work-detail__next">
      <span class="work-detail__next-label">Next project</span>
      <a href={`/work/${nextEntry.slug}`} class="work-detail__next-link">
        {nextEntry.title} →
      </a>
    </nav>
  </article>

  <CtaBand
    heading={`Want a video like${entry.client ? ` ${entry.client}'s` : ' this'}?`}
    accentPhrase=""
    primaryLabel="Start your project"
    primaryHref="/contact"
  />
</Base>

<style>
  .work-detail {
    max-width: 900px;
    padding-block: clamp(4rem, 8vw, 6rem) 4rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .work-detail__meta { display: flex; gap: 0.5rem; }

  .work-detail__title {
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: var(--lh-tight);
    color: var(--text-strong);
  }

  .work-detail__client {
    font-size: 1.1rem;
    color: var(--text-muted);
    font-style: italic;
    margin-top: -0.5rem;
  }

  /* Media container */
  .work-detail__media {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-card);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    background: #000;
    margin-block: 0.5rem;
  }

  .work-detail__video,
  .work-detail__iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: none;
  }

  .work-detail__link-out {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-weight: var(--fw-bold);
    font-size: 1.1rem;
    color: var(--accent-soft);
    background: var(--surface-card);
    text-decoration: none;
    transition: background var(--dur-fast), color var(--dur-fast);
  }

  .work-detail__link-out:hover { background: var(--surface-hover); color: var(--accent); }

  .work-detail__source {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-top: -0.75rem;
  }

  /* Body */
  .work-detail__body { max-width: var(--container-text); }

  .prose :global(p) {
    color: var(--text-body);
    font-size: 1.05rem;
    line-height: 1.75;
    margin-bottom: 1rem;
  }

  .prose :global(h2) {
    font-size: 1.4rem;
    color: var(--text-strong);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    letter-spacing: var(--tracking-tight);
  }

  .prose :global(h3) {
    font-size: 1.1rem;
    color: var(--text-strong);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .prose :global(ul), .prose :global(ol) {
    padding-left: 1.25rem;
    color: var(--text-body);
    line-height: 1.9;
    margin-bottom: 1rem;
  }

  .prose :global(li) { margin-bottom: 0.25rem; }

  .prose :global(strong) {
    font-weight: var(--fw-bold);
    color: var(--text-strong);
  }

  .placeholder { color: var(--text-faint); font-style: italic; }

  /* Next project nav */
  .work-detail__next {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border-subtle);
    margin-top: 1rem;
  }

  .work-detail__next-label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .work-detail__next-link {
    color: var(--accent-soft);
    font-weight: var(--fw-bold);
    font-size: 1.1rem;
    text-decoration: none;
    transition: color var(--dur-fast);
  }

  .work-detail__next-link:hover { color: var(--accent); }
</style>
