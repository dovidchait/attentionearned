---
import Base from '../../layouts/Base.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const entries = await getCollection('work');
  return entries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
};

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, client, sector, summary, video } = entry.data;

const sectorLabels: Record<string, string> = {
  corporate:  'Corporate',
  healthcare: 'Healthcare',
  nonprofit:  'Nonprofit',
  film:       'Film',
  brand:      'Brand',
};
---

<Base title={title} description={summary} ogImage={video?.poster}>
  <article class="work-article container">
    <header class="work-article__header">
      <span class="work-article__sector">{sectorLabels[sector]}</span>
      <h1>{title}</h1>
      {client && <p class="work-article__client">{client}</p>}
      <p class="work-article__summary">{summary}</p>
    </header>

    {video && (
      <div class="work-article__video">
        <VideoEmbed
          provider={video.provider}
          src={video.src}
          poster={video.poster}
          title={title}
        />
      </div>
    )}

    <div class="work-article__body prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .work-article {
    padding-block: var(--space-16) var(--space-24);
    max-width: 860px;
  }
  .work-article__header { margin-bottom: var(--space-10); }
  .work-article__sector {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin-bottom: var(--space-3);
  }
  .work-article__header h1 { font-size: var(--text-5xl); }
  .work-article__client {
    font-size: var(--text-base);
    color: var(--color-ink-muted);
    font-style: italic;
    margin-top: var(--space-2);
  }
  .work-article__summary {
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
    max-width: 60ch;
    line-height: var(--leading-loose);
    margin-top: var(--space-4);
  }
  .work-article__video { margin-block: var(--space-10); }
  .prose {
    max-width: var(--max-width-prose);
    margin-top: var(--space-10);
  }
  .prose :global(p) { margin-bottom: var(--space-4); line-height: var(--leading-loose); }
  .prose :global(h2) { font-size: var(--text-2xl); margin-top: var(--space-10); margin-bottom: var(--space-4); }
  .prose :global(h3) { font-size: var(--text-xl); margin-top: var(--space-8); margin-bottom: var(--space-3); }
  .prose :global(ul), .prose :global(ol) { padding-left: var(--space-6); margin-bottom: var(--space-4); }
  .prose :global(li) { margin-bottom: var(--space-2); }
  .prose :global(strong) { font-weight: var(--weight-semibold); }
</style>
