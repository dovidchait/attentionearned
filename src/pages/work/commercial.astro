---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import WorkCategoryGrid from '../../components/WorkCategoryGrid.astro';
import { AE_WORK } from '../../data/work';

const COMMERCIAL_SLUGS = ['gibor', 'gourmet-glatt-reels', 'elijah-deiz', 'nexivity-ad'];
const entries = COMMERCIAL_SLUGS.map(slug => AE_WORK.find(w => w.slug === slug)!).filter(Boolean);
---

<Base
  title="Commercial & Brand Video"
  description="Short-form ads, reels, and brand films for product and service businesses. Gibor, Gourmet Glatt, Nexivity, and more."
  ogImage="https://img.youtube.com/vi/XZzPeJ2xYkA/hqdefault.jpg"
>
  <section class="cat-page container">
    <div class="cat-page__header">
      <p class="cat-page__kicker">Commercial</p>
      <h1>Commercial & Brand Video</h1>
      <p class="cat-page__intro">
        Short-form ads, social reels, and brand films built to sell. Gibor, Gourmet Glatt, Elijah Diaz, Nexivity.
      </p>
      <p class="cat-page__back"><a href="/work">← All work</a></p>
    </div>

    <WorkCategoryGrid entries={entries} />
  </section>

  <CtaBand
    heading="Ready to make something people actually watch?"
    accentPhrase=""
    primaryLabel="Talk about your project"
    primaryHref="/contact"
  />
</Base>

<style>
  .cat-page { padding-block: clamp(4rem, 8vw, 6rem) 3rem; }
  .cat-page__header { margin-bottom: 2.5rem; }
  .cat-page__kicker {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-soft);
    margin-bottom: 0.5rem;
  }
  .cat-page h1 {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    color: var(--text-strong);
    margin-bottom: 0.875rem;
  }
  .cat-page__intro {
    max-width: 56ch;
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: var(--lh-body);
    margin-bottom: 0.5rem;
  }
  .cat-page__back a {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--text-faint);
    text-decoration: none;
    transition: color var(--dur-fast);
  }
  .cat-page__back a:hover { color: var(--text-muted); }
</style>
