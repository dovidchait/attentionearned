---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import WorkCategoryGrid from '../../components/WorkCategoryGrid.astro';
import { AE_WORK } from '../../data/work';

const entries = AE_WORK.filter(w => w.sector === 'Music video');
---

<Base
  title="Music Video Production"
  description="Original music videos directed and shot by Attention Earned — compelling storytelling for Jewish music artists."
  ogImage="https://img.youtube.com/vi/Wrm74AJAFtE/hqdefault.jpg"
>
  <section class="cat-page container">
    <div class="cat-page__header">
      <p class="cat-page__kicker">Music video</p>
      <h1>Music Videos</h1>
      <p class="cat-page__intro">
        Original music video production — direction, cinematography, and storytelling for artists who want more than a performance clip.
      </p>
      <p class="cat-page__back"><a href="/work">← All work</a></p>
    </div>

    <WorkCategoryGrid entries={entries} />
  </section>

  <CtaBand
    heading="Have a song that needs a story?"
    accentPhrase=""
    primaryLabel="Tell us about your project"
    primaryHref="/contact"
  />
</Base>

<style>
  .cat-page { padding-block: clamp(4rem, 8vw, 6rem) 3rem; }

  .cat-page__header { margin-bottom: 2.5rem; }

  .cat-page__kicker {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-soft);
    margin-bottom: 0.5rem;
  }

  .cat-page h1 {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    color: var(--text-strong);
    margin-bottom: 0.875rem;
  }

  .cat-page__intro {
    max-width: 56ch;
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: var(--lh-body);
    margin-bottom: 0.5rem;
  }

  .cat-page__back a {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--text-faint);
    text-decoration: none;
    transition: color var(--dur-fast);
  }

  .cat-page__back a:hover { color: var(--text-muted); }
</style>
