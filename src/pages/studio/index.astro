---
import Base from '../../layouts/Base.astro';
---

<Base title="Studio — Turn every video into a week of content" noNav noFooter>
  <div class="studio-lp">

    <header class="lp-nav">
      <a href="/" class="lp-wordmark">
        <img src="/wordmark-white.svg" alt="Attention Earned" height="20" />
      </a>
      <div class="lp-nav-actions">
        <a href="/studio/login" class="lp-nav-link">Log in</a>
        <a href="/studio/signup" class="lp-btn-sm">Get started free</a>
      </div>
    </header>

    <section class="lp-hero">
      <div class="lp-hero-inner">
        <div class="lp-kicker">Attention Earned Studio</div>
        <h1 class="lp-headline">
          Turn every video into<br />
          a week of content
        </h1>
        <p class="lp-sub">
          Upload your footage or paste a video URL. Get a transcript, Instagram and LinkedIn
          captions, and a graphic — then schedule everything directly to your social accounts.
          Built for nonprofits and small businesses who create their own content.
        </p>
        <div class="lp-ctas">
          <a href="/studio/signup" class="lp-btn-primary">Start for free</a>
          <a href="/studio/login" class="lp-btn-ghost">Log into your account →</a>
        </div>
      </div>
    </section>

    <section class="lp-steps">
      <div class="lp-steps-inner">
        <h2 class="lp-steps-title">How it works</h2>
        <ol class="lp-step-list">
          {[
            { n: '01', title: 'Upload or paste', body: "Drop a video file or paste any video URL. We'll transcribe it automatically." },
            { n: '02', title: 'Edit your captions', body: 'Get Instagram, LinkedIn, and TikTok captions written from your transcript. Edit anything.' },
            { n: '03', title: 'Generate a graphic', body: 'Describe the image you need. Pick from four Ideogram-generated options.' },
            { n: '04', title: 'Schedule everywhere', body: 'Select your connected accounts, pick a date and time, and post — all in one click.' },
          ].map(({ n, title, body }) => (
            <li class="lp-step">
              <span class="lp-step-num">{n}</span>
              <div>
                <h3 class="lp-step-title">{title}</h3>
                <p class="lp-step-body">{body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="lp-platforms">
      <div class="lp-platforms-inner">
        <p class="lp-platforms-label">Posts to</p>
        <div class="lp-platform-chips">
          {['Instagram', 'LinkedIn', 'TikTok', 'Facebook', 'YouTube'].map((p) => (
            <span class="lp-chip">{p}</span>
          ))}
        </div>
      </div>
    </section>

    <section class="lp-cta-band">
      <div class="lp-cta-band-inner">
        <h2>Ready to stop leaving content on the table?</h2>
        <a href="/studio/signup" class="lp-btn-primary">Create your free account</a>
      </div>
    </section>

    <footer class="lp-footer">
      <div class="lp-footer-inner">
        <a href="/" class="lp-footer-wordmark">
          <img src="/wordmark-white.svg" alt="Attention Earned" height="16" />
        </a>
        <nav class="lp-footer-links">
          <a href="/privacy">Privacy</a>
          <a href="/contact">Contact</a>
        </nav>
      </div>
    </footer>

  </div>
</Base>

<style>
  .studio-lp {
    min-height: 100dvh;
    background: var(--ink-950);
    display: flex;
    flex-direction: column;
  }

  /* Nav */
  .lp-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem var(--gutter);
    border-bottom: 1px solid var(--border-subtle);
    position: sticky;
    top: 0;
    background: rgba(11, 10, 9, 0.88);
    backdrop-filter: blur(12px);
    z-index: 10;
  }

  .lp-wordmark img { height: 20px; width: auto; }

  .lp-nav-actions { display: flex; align-items: center; gap: 1rem; }

  .lp-nav-link {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    transition: color var(--dur-fast);
  }
  .lp-nav-link:hover { color: var(--text-strong); }

  .lp-btn-sm {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 1.1rem;
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    background: var(--grad-cta);
    color: var(--text-on-accent);
    border-radius: var(--radius-pill);
    box-shadow: var(--glow-cta);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .lp-btn-sm:hover { transform: translateY(-1px); }

  /* Hero */
  .lp-hero {
    flex: 1;
    display: flex;
    align-items: center;
    padding: 6rem var(--gutter) 5rem;
    background: var(--grad-hero);
  }

  .lp-hero-inner {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .lp-kicker {
    display: inline-block;
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ae-coral);
    margin-bottom: 1.25rem;
  }

  .lp-headline {
    font-size: var(--fs-display-xl);
    letter-spacing: var(--tracking-display);
    color: var(--text-strong);
    margin-bottom: 1.5rem;
  }

  .lp-sub {
    font-size: var(--fs-body-lg);
    color: var(--text-body);
    max-width: 560px;
    margin: 0 auto 2.5rem;
    line-height: 1.65;
  }

  .lp-ctas {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .lp-btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.8rem 2rem;
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    background: var(--grad-cta);
    color: var(--text-on-accent);
    border-radius: var(--radius-pill);
    box-shadow: var(--glow-cta);
    transition: transform var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  }
  .lp-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 50px -8px rgba(252,44,48,.7), 0 0 0 1px rgba(252,44,48,.4);
  }

  .lp-btn-ghost {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    transition: color var(--dur-fast);
  }
  .lp-btn-ghost:hover { color: var(--text-strong); }

  /* Steps */
  .lp-steps {
    padding: 5rem var(--gutter);
    background: var(--ink-900);
    border-top: 1px solid var(--border-subtle);
  }

  .lp-steps-inner { max-width: 760px; margin: 0 auto; }

  .lp-steps-title {
    font-size: var(--fs-h2);
    margin-bottom: 3rem;
    text-align: center;
  }

  .lp-step-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .lp-step {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .lp-step-num {
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    font-family: var(--font-mono);
    color: var(--ae-coral);
    flex-shrink: 0;
    width: 2.5rem;
    padding-top: 0.15rem;
  }

  .lp-step-title {
    font-size: var(--fs-h3);
    margin-bottom: 0.35rem;
  }

  .lp-step-body {
    color: var(--text-muted);
    max-width: 480px;
  }

  /* Platforms */
  .lp-platforms {
    padding: 3rem var(--gutter);
    border-top: 1px solid var(--border-subtle);
  }

  .lp-platforms-inner {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .lp-platforms-label {
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .lp-platform-chips { display: flex; gap: 0.5rem; flex-wrap: wrap; }

  .lp-chip {
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    padding: 0.3rem 0.8rem;
    background: var(--surface-card);
    border: 1px solid var(--border-mid);
    border-radius: var(--radius-pill);
    color: var(--text-body);
  }

  /* CTA band */
  .lp-cta-band {
    padding: 5rem var(--gutter);
    background: var(--ink-850);
    border-top: 1px solid var(--border-subtle);
    text-align: center;
  }

  .lp-cta-band-inner { max-width: 600px; margin: 0 auto; }
  .lp-cta-band-inner h2 { font-size: var(--fs-display-lg); margin-bottom: 2rem; }

  /* Footer */
  .lp-footer {
    padding: 2rem var(--gutter);
    border-top: 1px solid var(--border-subtle);
  }

  .lp-footer-inner {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .lp-footer-wordmark img { height: 16px; width: auto; }

  .lp-footer-links {
    display: flex;
    gap: 1.25rem;
    font-size: var(--fs-sm);
    color: var(--text-faint);
  }
  .lp-footer-links a:hover { color: var(--text-muted); }
</style>
