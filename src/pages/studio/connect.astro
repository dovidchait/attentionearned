---
export const prerender = false;
import { UserButton } from '@clerk/astro/components';
import Base from '../../layouts/Base.astro';

const { sessionClaims } = Astro.locals.auth();
const meta = (sessionClaims?.publicMetadata ?? {}) as { zernio_profile_id?: string };
const profileId = meta.zernio_profile_id;
---
<Base title="Connect Accounts | Attention Earned Studio" noNav noFooter>
  <div class="studio-layout">
    <nav class="studio-nav">
      <a href="/studio/dashboard" class="studio-logo">
        <img src="/mark.svg" alt="Attention Earned" width="28" height="28" />
        <span>Studio</span>
      </a>

      <ul class="studio-nav__links">
        <li>
          <a href="/studio/dashboard" class="studio-nav__link">Dashboard</a>
        </li>
        <li>
          <a href="/studio/create" class="studio-nav__link">Create</a>
        </li>
        <li>
          <a href="/studio/connect" class="studio-nav__link" aria-current="page">
            Connect accounts
          </a>
        </li>
      </ul>

      <div class="studio-nav__user">
        <UserButton />
      </div>
    </nav>

    <main class="studio-main">
      <h1>Connect social accounts</h1>

      {!profileId ? (
        <p class="notice notice--warn">
          Your profile is still provisioning. Refresh in a moment before connecting accounts.
        </p>
      ) : (
        <div class="platforms">
          {['instagram', 'facebook', 'tiktok', 'linkedin', 'youtube', 'twitter'].map((platform) => (
            <a
              href={`/api/studio/connect/${platform}?profileId=${profileId}`}
              class="platform-card"
            >
              <span class="platform-name">{platform.charAt(0).toUpperCase() + platform.slice(1)}</span>
              <span class="platform-cta">Connect →</span>
            </a>
          ))}
        </div>
      )}
    </main>
  </div>
</Base>

<style>
  .studio-layout {
    display: grid;
    grid-template-columns: 220px 1fr;
    min-height: 100dvh;
  }

  .studio-nav {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 1.5rem 1rem;
    background: var(--surface-raised, #111);
    border-right: 1px solid var(--border-subtle, #222);
  }

  .studio-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 1rem;
    color: var(--text-strong);
  }

  .studio-nav__links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
  }

  .studio-nav__link {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm, 6px);
    color: var(--text-muted, #aaa);
    font-size: 0.875rem;
    transition: background 0.15s, color 0.15s;
  }

  .studio-nav__link:hover,
  .studio-nav__link[aria-current="page"] {
    background: var(--surface-hover, #222);
    color: var(--text-strong);
  }

  .studio-nav__user {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle, #222);
  }

  .studio-main {
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .studio-main h1 {
    font-size: 1.5rem;
  }

  .notice {
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm, 6px);
    font-size: 0.875rem;
  }

  .notice--warn {
    background: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.3);
    color: var(--color-warn, #f59e0b);
  }

  .platforms {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1rem;
  }

  .platform-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    border: 1px solid var(--border-subtle, #333);
    border-radius: var(--radius-sm, 8px);
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s;
  }

  .platform-card:hover {
    border-color: var(--color-brand, #fff);
    background: var(--surface-hover, #1a1a1a);
  }

  .platform-name {
    font-weight: 600;
    color: var(--text-strong);
  }

  .platform-cta {
    font-size: 0.8rem;
    color: var(--text-muted, #aaa);
  }

  @media (max-width: 640px) {
    .studio-layout {
      grid-template-columns: 1fr;
    }

    .studio-nav {
      flex-direction: row;
      align-items: center;
      border-right: none;
      border-bottom: 1px solid var(--border-subtle, #222);
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .studio-nav__links {
      flex-direction: row;
      flex: none;
    }

    .studio-nav__user {
      margin-top: 0;
      padding-top: 0;
      border-top: none;
      margin-left: auto;
    }
  }
</style>
