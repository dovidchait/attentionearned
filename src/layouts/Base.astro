---
import '../styles/tokens.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  noNav?: boolean;
  noFooter?: boolean;
}

const {
  title,
  description = 'Attention Earned. Video production that makes people buy, know you, or act.',
  ogImage,
  noindex = false,
  noNav = false,
  noFooter = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title.includes('Attention Earned') ? title : `${title} | Attention Earned`;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/mark.svg" />
  <link rel="canonical" href={canonicalURL} />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}

  <script is:inline src="https://assets.swarmify.com/swarmify.js?key=6d594846-2bde-402b-887e-b830a14569f1" async></script>

  <script is:inline>
    (function(c,l,a,r,i,t,y){
      c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
      t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "vgao84s2im");
  </script>

  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: var(--font-sans);
      font-size: var(--fs-body);
      line-height: var(--lh-body);
      color: var(--text-body);
      background-color: var(--surface-base);
      -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3, h4, h5, h6 {
      font-family: var(--font-display);
      font-weight: var(--fw-black);
      line-height: var(--lh-tight);
      color: var(--text-strong);
      letter-spacing: var(--tracking-display);
    }

    a { color: inherit; text-decoration: none; }
    a:focus-visible {
      outline: 2px solid var(--focus-ring);
      outline-offset: 3px;
      border-radius: var(--radius-xs);
    }

    img, video { max-width: 100%; display: block; }

    .container {
      max-width: var(--container);
      margin-inline: auto;
      padding-inline: var(--gutter);
    }

    @keyframes aeRise {
      from { opacity: 0; transform: translateY(18px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .ae-reveal { animation: aeRise 0.7s cubic-bezier(.2,.8,.2,1) both; }

    /* ── Global button system ─────────────── */
    .ae-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      font-family: var(--font-sans);
      font-weight: var(--fw-bold);
      border-radius: var(--radius-pill);
      border: none;
      cursor: pointer;
      text-decoration: none;
      white-space: nowrap;
      transition:
        transform var(--dur-base) var(--ease-out),
        box-shadow var(--dur-base) var(--ease-out),
        background var(--dur-base) var(--ease-out),
        border-color var(--dur-base) var(--ease-out),
        color var(--dur-base) var(--ease-out);
    }
    .ae-btn:disabled, .ae-btn[disabled] { opacity: 0.45; cursor: not-allowed; pointer-events: none; }
    .ae-btn--sm { font-size: var(--fs-xs); padding: 0.45rem 0.9rem; letter-spacing: var(--tracking-wide); text-transform: uppercase; }
    .ae-btn--md { font-size: var(--fs-sm); padding: 0.65rem 1.3rem; letter-spacing: var(--tracking-wide); text-transform: uppercase; }
    .ae-btn--lg { font-size: var(--fs-body); padding: 0.85rem 1.8rem; letter-spacing: 0.04em; }
    .ae-btn--primary { background: var(--grad-cta); color: var(--text-on-accent); box-shadow: var(--glow-cta); }
    .ae-btn--primary:hover { transform: translateY(-1px); box-shadow: 0 14px 50px -8px rgba(252,44,48,.7), 0 0 0 1px rgba(252,44,48,.4); }
    .ae-btn--primary:active { transform: scale(0.98); box-shadow: var(--glow-cta); }
    .ae-btn--secondary { background: transparent; color: var(--text-strong); border: 1px solid var(--border-strong); }
    .ae-btn--secondary:hover { border-color: var(--accent); color: var(--accent-soft); transform: translateY(-1px); }
    .ae-btn--secondary:active { transform: scale(0.98); }
    .ae-btn--ghost { background: transparent; color: var(--text-body); border: 1px solid transparent; }
    .ae-btn--ghost:hover { background: var(--surface-hover); color: var(--text-strong); }
    .ae-btn--link { background: transparent; color: var(--accent-soft); border-radius: 0; padding-inline: 0; }
    .ae-btn--link:hover { color: var(--accent); }
  </style>
</head>
<body>
  {!noNav && <Nav />}
  <main id="main-content">
    <slot />
  </main>
  {!noFooter && <Footer />}
</body>
</html>
