---
import '../styles/tokens.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  noNav?: boolean;
  noFooter?: boolean;
}

const {
  title,
  description = 'Attention Earned. Video production that makes people buy, know you, or act.',
  ogImage,
  noindex = false,
  noNav = false,
  noFooter = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title.includes('Attention Earned') ? title : `${title} | Attention Earned`;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/mark.svg" />
  <link rel="canonical" href={canonicalURL} />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}

  <script is:inline src="https://assets.swarmify.com/swarmify.js?key=6d594846-2bde-402b-887e-b830a14569f1" async></script>

  <!-- Google Analytics -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-4MKPN5MJNY"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-4MKPN5MJNY');
  </script>

  <script is:inline>
    (function(c,l,a,r,i,t,y){
      c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
      t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "vgao84s2im");
  </script>

  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: var(--font-sans);
      font-size: var(--fs-body);
      line-height: var(--lh-body);
      color: var(--text-body);
      background-color: var(--surface-base);
      -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3, h4, h5, h6 {
      font-family: var(--font-display);
      font-weight: var(--fw-black);
      line-height: var(--lh-tight);
      color: var(--text-strong);
      letter-spacing: var(--tracking-display);
    }

    a { color: inherit; text-decoration: none; }
    a:focus-visible {
      outline: 2px solid var(--focus-ring);
      outline-offset: 3px;
      border-radius: var(--radius-xs);
    }

    img, video { max-width: 100%; display: block; }

    .container {
      max-width: var(--container);
      margin-inline: auto;
      padding-inline: var(--gutter);
    }

    @keyframes aeRise {
      from { opacity: 0; transform: translateY(18px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .ae-reveal { animation: aeRise 0.7s cubic-bezier(.2,.8,.2,1) both; }
  </style>
</head>
<body>
  {!noNav && <Nav />}
  <main id="main-content">
    <slot />
  </main>
  {!noFooter && <Footer />}
</body>
</html>
