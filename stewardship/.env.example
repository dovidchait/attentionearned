# Required: Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stewardship

# SAFETY: defaults to true in ALL environments. Set to false only in production with explicit intent.
DRY_RUN=true

# Controls whether the send pipeline is globally active. Default: false.
SEND_ENABLED=false

# Logging
LOG_LEVEL=info

# Object storage (S3-compatible)
S3_BUCKET=stewardship-media
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Zernio (WhatsApp + SMS)
ZERNIO_API_KEY=
ZERNIO_BASE_URL=https://api.zernio.io

# EmailIt
EMAILIT_API_KEY=
EMAILIT_BASE_URL=https://api.emailit.com
